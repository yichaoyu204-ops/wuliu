.container {
  padding: 32rpx;
  background: #f4f6fa;
  min-height: 100vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.header {
  margin-bottom: 32rpx;
}

.header-title {
  display: block;
  font-size: 50rpx;
  font-weight: 700;
  color: #171b22;
}

.header-desc {
  display: block;
  font-size: 26rpx;
  color: #596577;
  margin-top: 8rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-id {
  font-size: 30rpx;
  font-weight: 600;
  color: #171b22;
}

.card-status {
  font-size: 25rpx;
  color: #2156f3;
  background: #FFF8F0;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.card-body {
  margin-bottom: 16rpx;
}

.card-factory {
  display: block;
  font-size: 28rpx;
  color: #171b22;
  margin-bottom: 8rpx;
}

.card-info {
  display: block;
  font-size: 25rpx;
  color: #596577;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #e1e6ee;
  padding-top: 16rpx;
}

.card-time {
  font-size: 25rpx;
  color: #596577;
}

.btn-measure {
  background: #2156f3;
  color: #fff;
  font-size: 26rpx;
  padding: 10rpx 28rpx;
  border-radius: 12rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #596577;
}

@import "../../../styles/ui.wxss";

.card { border: 1rpx solid #e1e6ee; border-radius: 14rpx; }
.card-status { background: #eef2ff; color: #2156f3; }
.card-header, .card-footer { gap: 16rpx; flex-wrap: wrap; }
.card-id { min-width: 0; word-break: break-all; }
.btn-measure { min-height: 72rpx; padding: 16rpx 24rpx; box-sizing: border-box; }
