@import "../../styles/ui.wxss";
/* Approved direction 01. Business events and data remain in the original template. */
.container{min-height:100vh;background:#fff;color:#171b22;padding:46rpx 48rpx calc(144rpx + env(safe-area-inset-bottom));line-height:1.4}
.search-section{margin:0;padding:0;background:transparent;border:0;box-shadow:none;border-radius:0}
.top-bar{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:44rpx}.brand-lockup{display:flex;align-items:center;gap:18rpx}.brand-label{font-size:32rpx;font-weight:650;letter-spacing:1rpx;color:#171b22}.brand-mark{width:52rpx;height:44rpx;display:flex;gap:6rpx;align-items:center;transform:skew(-16deg)}.brand-mark view{width:12rpx;height:38rpx;background:#2156f3}.brand-mark view:nth-child(2){height:26rpx}.brand-mark view:nth-child(3){height:16rpx}
.logout-btn{font-size:24rpx;line-height:1.4;color:#536174;padding:10rpx 0 10rpx 20rpx;min-height:60rpx;display:flex;align-items:center}
.search-title{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:30rpx}.search-heading{display:block;font-size:78rpx;line-height:1.18;font-weight:650;letter-spacing:-2.8rpx;color:#14171d}.heading-box{width:60rpx;height:60rpx;flex-shrink:0;background:url('data:image/png;base64,') center/contain no-repeat}
.brand-route{display:flex;align-items:center;gap:25rpx;margin:34rpx 0 38rpx}.route-caption{display:block;color:#526176;font-size:24rpx;line-height:1.4;margin-bottom:14rpx}.route-city{display:block;font-size:43rpx;line-height:1.25;font-weight:550;color:#171b22;letter-spacing:1.4rpx}.brand-route-line{height:2rpx;flex:1;position:relative;background:#cbd5e2;margin:8rpx 12rpx 0}.brand-route-line::after{content:'';position:absolute;right:0;top:-6rpx;width:12rpx;height:12rpx;border-top:2rpx solid #cbd5e2;border-right:2rpx solid #cbd5e2;transform:rotate(45deg)}
.search-box{display:flex;align-items:center;gap:12rpx;height:110rpx;padding:8rpx 8rpx 8rpx 28rpx;background:#f3f5f9;border:1rpx solid #e5e9f0;border-radius:10rpx}.search-symbol{width:38rpx;height:38rpx;flex-shrink:0;background:url('data:image/png;base64,') center/contain no-repeat}.search-input{flex:1;min-width:0;width:0;height:88rpx;font-size:29rpx;color:#171b22;line-height:1.5}.search-btn{height:92rpx;min-width:116rpx;flex-shrink:0;padding:0 20rpx;display:flex;align-items:center;justify-content:center;background:#2156f3;color:#fff;border-radius:6rpx;font-size:31rpx;font-weight:600}
.pending-banner{margin-top:40rpx;padding:34rpx 38rpx;border-radius:20rpx;background:#2156f3;color:#fff;box-shadow:0 12rpx 34rpx rgba(33,86,243,.12);min-height:216rpx}.pending-content{display:flex;align-items:center;justify-content:space-between;gap:24rpx;min-height:148rpx}.pending-summary{display:flex;flex-direction:column;gap:16rpx;min-width:0}.pending-label{display:block;font-size:33rpx;line-height:1.3;font-weight:550;letter-spacing:.4rpx}.pending-amount{display:flex;align-items:baseline;flex-wrap:wrap;gap:14rpx}.pending-count{display:block;font-size:86rpx;line-height:1;font-weight:600;letter-spacing:-2rpx;font-variant-numeric:tabular-nums;word-break:break-all}.pending-unit{font-size:27rpx;line-height:1.4;white-space:nowrap}.pending-action{display:flex;align-items:center;justify-content:center;gap:10rpx;flex-shrink:0;padding:0 22rpx;min-height:84rpx;border-radius:12rpx;background:#fff;color:#1745c8;font-size:27rpx;font-weight:600;white-space:nowrap}.pending-action-arrow{width:32rpx;height:32rpx;background:url('data:image/png;base64,') center/contain no-repeat}
.feature-grid{display:flex;gap:0;padding:42rpx 0 40rpx;margin:0 0 38rpx;border-bottom:1rpx solid #e1e6ed}.feature-item{flex:1;min-width:0;display:flex;align-items:center;flex-direction:column;gap:22rpx;padding:0 2rpx;background:transparent;border:0;box-shadow:none}.feature-icon{width:46rpx;height:46rpx;position:relative;margin:0;background-position:center;background-size:contain;background-repeat:no-repeat}.feature-icon view{display:none}.feature-icon-waybill{background-image:url('data:image/png;base64,')}.feature-icon-scan{background-image:url('data:image/png;base64,')}.feature-icon-service{background-image:url('data:image/png;base64,')}.feature-text{font-size:28rpx;line-height:1.4;color:#233047;font-weight:400;white-space:nowrap}
.section-title{display:flex;align-items:center;justify-content:space-between;gap:12rpx;min-height:48rpx;margin-bottom:0;padding:0;background:transparent;border:0;font-size:35rpx;line-height:1.4;font-weight:650;color:#171b22}.clear-btn{font-size:27rpx;line-height:1.4;color:#566477;padding:8rpx 0 8rpx 16rpx;font-weight:400}.history-list{margin-top:22rpx;padding:0 30rpx;background:#f5f7fb;border-radius:10rpx}.history-item{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:27rpx 0;min-height:94rpx;border:0;border-bottom:1rpx solid #e1e6ee;background:transparent}.history-item:last-child{border-bottom:0}.history-text{font-size:29rpx;line-height:1.4;color:#273449;word-break:break-all;min-width:0;flex:1}.history-item:first-child .history-text{font-size:33rpx;font-weight:550;color:#171d26}.history-arrow{font-size:32rpx;line-height:1;color:#2156f3}.result-section{margin-top:0}.result-section .section-title{margin-bottom:24rpx}
.shipment-card { position: relative; padding: 28rpx; margin-bottom: 22rpx; border: 1rpx solid #e1e6ee; border-radius: 12rpx; background: #ffffff; box-shadow: none; }
.shipment-header { display: flex; flex-direction: column; gap: 16rpx; padding-bottom: 22rpx; border-bottom: 1rpx solid #edf0f5; }.shipment-id { font-size: 36rpx; font-weight: 650; line-height: 1.4; word-break: break-all; }.shipment-tags { display: flex; flex-wrap: wrap; gap: 10rpx; }
.status-tag, .appointment-mini-tag { padding: 7rpx 14rpx; font-size: 25rpx; line-height: 1.45; border-radius: 8rpx; color: #596577; background: #eff3f9; }.status-tag.active, .appointment-mini-tag.pending { color: #965027; background: #fcf0dd; }.status-tag.completed, .appointment-mini-tag.done { color: #16776d; background: #eaf6f1; }
.shipment-info { display: flex; flex-direction: column; gap: 12rpx; padding: 22rpx 0; }.factory-name { font-size: 30rpx; font-weight: 500; color: #171b22; }.cargo-desc { font-size: 25rpx; line-height: 1.6; color: #5e6b7e; word-break: break-all; }.shipment-footer { display: flex; justify-content: space-between; gap: 14rpx; flex-wrap: wrap; padding-top: 18rpx; border-top: 1rpx solid #edf0f5; }.route-name { font-size: 25rpx; font-weight: 500; color: #315493; }.create-time { color: #657287; font-size: 22rpx; }
.empty-result { text-align: center; padding: 64rpx 28rpx; }.empty-text { display: block; font-size: 30rpx; font-weight: 600; color: #171b22; }.empty-hint { display: block; font-size: 26rpx; color: #5e6b7e; margin-top: 14rpx; line-height: 1.7; }
.empty-section { margin: 0; }.empty-box { padding: 34rpx 0; background: transparent; border: 0; box-shadow: none; border-top: 1rpx solid #e1e6ee; border-radius: 0; }.empty-visual { position: relative; width: 112rpx; height: 52rpx; margin-bottom: 24rpx; }.empty-line { position: absolute; left: 0; width: 112rpx; height: 2rpx; top: 24rpx; background: #d7e0ee; }.empty-line-sub { width: 48rpx; background: #2156f3; }.empty-dot { position: absolute; width: 16rpx; height: 16rpx; top: 17rpx; border: 3rpx solid #2156f3; border-radius: 50%; background: #f4f6fa; }.empty-dot-left { left: 0; }.empty-dot-right { right: 0; border-color: #9db2df; }.empty-title { display: block; font-size: 30rpx; line-height: 1.5; font-weight: 500; }.empty-desc { display: block; font-size: 25rpx; line-height: 1.7; color: #5e6b7e; margin-top: 14rpx; }.empty-tip { margin-top: 24rpx; color: #5e6b7e; font-size: 24rpx; }
.contact-mask { position: fixed; inset: 0; background: rgba(12,29,22,.48); z-index: 10000; display: flex; align-items: flex-end; }.contact-popup { width: 100%; padding: 28rpx 32rpx calc(36rpx + env(safe-area-inset-bottom)); background: #ffffff; border-radius: 34rpx 34rpx 0 0; animation: yichao-sheet .24s ease-out; }.contact-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }.contact-title { font-size: 36rpx; color: #171b22; font-weight: 600; }.contact-close { min-width: 88rpx; min-height: 88rpx; line-height: 88rpx; text-align: right; font-size: 30rpx; color: #5e6b7e; }.contact-item { display: flex; align-items: center; padding: 28rpx 0; border-top: 1rpx solid #edf0f5; }.contact-avatar { width: 76rpx; height: 76rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; border-radius: 24rpx; margin-right: 22rpx; color: #273449; }.contact-info { flex: 1; min-width: 0; }.contact-name { display: block; font-size: 30rpx; color: #171b22; }.contact-phone { display: block; font-size: 26rpx; color: #5e6b7e; margin-top: 8rpx; }.contact-arrow { color: #ffffff; font-size: 27rpx; background: #171b22; padding: 22rpx 24rpx; border-radius: 14rpx; }
@keyframes yichao-sheet { from { transform: translateY(24rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@media (prefers-reduced-motion: reduce) { .contact-popup { animation: none; }.feature-item { transition: none; } }

.shipment-card{border-radius:14rpx;padding:30rpx;box-shadow:none}.shipment-id{font-size:35rpx}.cargo-desc{font-size:27rpx}.create-time{font-size:25rpx}.contact-mask{left:0;right:0}.contact-popup{box-sizing:border-box}.contact-phone{font-size:28rpx}.contact-arrow{background:#2156f3}.contact-avatar{background:#eef3ff!important;color:#2156f3}.empty-box{border-radius:0;background:transparent}.empty-icon{margin-top:24rpx}
@media(max-width:350px){.container{padding-left:40rpx;padding-right:40rpx}.pending-banner{padding-left:30rpx;padding-right:30rpx}.pending-action{padding-left:18rpx;padding-right:18rpx;font-size:26rpx}.search-heading{font-size:76rpx}.search-input{font-size:28rpx}}
