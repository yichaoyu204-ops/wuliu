.container {
  padding: 40rpx 32rpx;
  background: #f4f6fa;
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.header {
  margin-bottom: 40rpx;
}

.header-title {
  display: block;
  font-size: 50rpx;
  font-weight: 700;
  color: #171b22;
}

.header-desc {
  display: block;
  font-size: 26rpx;
  color: #596577;
  margin-top: 8rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.search-btn {
  background: #2156f3;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 32rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.scan-btn {
  background: #171b22;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 32rpx;
  border-radius: 12rpx;
  font-weight: 600;
}

.shipment-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-header {
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #e1e6ee;
}

.card-id {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #171b22;
  margin-bottom: 8rpx;
}

.card-factory {
  display: block;
  font-size: 26rpx;
  color: #596577;
}

.node-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e1e6ee;
}

.node-info:last-of-type {
  border-bottom: none;
}

.node-label {
  font-size: 28rpx;
  color: #344156;
}

.node-value {
  font-size: 28rpx;
  color: #171b22;
  font-weight: 600;
}

.node-value.active {
  color: #2156f3;
}

.node-value.next {
  color: #4CAF50;
}

.action-area {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e1e6ee;
}

.btn-advance {
  background: #2156f3;
  color: #fff;
  text-align: center;
  padding: 28rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-advance.disabled {
  background: #AFC2FF;
}

.complete-area {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e1e6ee;
  text-align: center;
}

.complete-text {
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: 600;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #596577;
}

.hint {
  text-align: center;
  padding: 120rpx 40rpx;
}

.hint-text {
  font-size: 28rpx;
  color: #596577;
}

@import "../../../styles/ui.wxss";

.search-input { min-width: 0; width: 0; }
.shipment-card { border: 1rpx solid #e1e6ee; border-radius: 14rpx; box-shadow: none; }
.card-id { word-break: break-all; }
.node-info { gap: 16rpx; flex-wrap: wrap; }
.node-value { max-width: 100%; word-break: break-all; }
