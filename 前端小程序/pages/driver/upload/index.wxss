.container {
  padding: 40rpx 32rpx;
  background: #f4f6fa;
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.header {
  margin-bottom: 40rpx;
}

.header-title {
  display: block;
  font-size: 50rpx;
  font-weight: 700;
  color: #171b22;
}

.header-desc {
  display: block;
  font-size: 26rpx;
  color: #596577;
  margin-top: 8rpx;
}

.upload-section {
  margin-bottom: 40rpx;
}

.upload-card {
  background: #fff;
  border: 2rpx dashed #2156f3;
  border-radius: 16rpx;
  padding: 80rpx;
  text-align: center;
}

.upload-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}

.upload-label {
  display: block;
  font-size: 30rpx;
  color: #2156f3;
  font-weight: 600;
}

.preview-section {
  margin-bottom: 40rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
}

.preview-img {
  width: 100%;
  height: 400rpx;
  border-radius: 8rpx;
}

.preview-retry {
  font-size: 28rpx;
  color: #2156f3;
  margin-top: 16rpx;
  display: block;
}

.ai-status {
  text-align: center;
  padding: 40rpx;
}

.ai-loading {
  font-size: 28rpx;
  color: #2156f3;
}

.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #171b22;
  margin-bottom: 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e1e6ee;
}

.form-row:last-child {
  border-bottom: none;
}

.form-row.row-warning {
  background: #FFF8F0;
  margin: 0 -32rpx;
  padding: 20rpx 32rpx;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #344156;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #171b22;
  height: 48rpx;
  line-height: 48rpx;
}

.form-picker {
  width: 120rpx;
  text-align: right;
  font-size: 26rpx;
  color: #2156f3;
  flex-shrink: 0;
}

.form-picker-wide {
  flex: 1;
  font-size: 28rpx;
  color: #171b22;
}

.form-picker-date {
  width: 220rpx;
  font-size: 28rpx;
  color: #171b22;
  flex-shrink: 0;
}

.form-picker-time {
  width: 160rpx;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #171b22;
  flex-shrink: 0;
}

.date-picker-text {
  font-size: 28rpx;
  color: #171b22;
}

.date-picker-text.placeholder {
  color: #596577;
}

.form-picker-with-clear {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.clear-btn {
  font-size: 25rpx;
  color: #E53935;
  margin-left: 16rpx;
  padding: 4rpx 12rpx;
}

.submit-area {
  margin-top: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.btn-submit {
  background: #2156f3;
  color: #fff;
  text-align: center;
  padding: 28rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-submit.btn-disabled {
  background: #AFC2FF;
}

.submit-hint {
  display: block;
  text-align: center;
  font-size: 25rpx;
  color: #596577;
  margin-top: 16rpx;
}

@import "../../../styles/ui.wxss";

.form-input, .form-picker-wide, .form-picker-with-clear { min-width: 0; }
.form-row { gap: 12rpx; }
.form-section, .preview-section { border: 1rpx solid #e1e6ee; border-radius: 14rpx; }
@media (max-width: 350px) { .form-row { flex-wrap: wrap; } .form-picker-date, .form-picker-time { flex-shrink: 1; } }
