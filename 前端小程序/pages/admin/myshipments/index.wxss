@import "../../../styles/ui.wxss";

/* A quiet hierarchy: order number, appointment, then transport status. */
.container {
  background: #f3f5f8;
  color: #192b43;
  min-height: 100vh;
}

.tip-bar {
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  padding: 20rpx 28rpx 4rpx;
}

.tip-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #657184;
}

.shipment-list { padding: 24rpx; }
.month-section { margin-bottom: 36rpx; }
.month-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4rpx 18rpx;
}
.month-title {
  color: #192b43;
  font-size: 32rpx;
  font-weight: 650;
  letter-spacing: -0.5rpx;
}
.month-count { color: #657184; font-size: 24rpx; }

.shipment-card {
  background: #fff;
  border: 1rpx solid #e4e8ee;
  border-radius: 18rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(25, 43, 67, 0.025);
}
.card-header { display: block; margin-bottom: 24rpx; }
.shipment-caption {
  display: block;
  margin-bottom: 6rpx;
  color: #657184;
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 2rpx;
}
.card-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  min-width: 0;
}
.shipment-id {
  flex: 1;
  min-width: 0;
  color: #192b43;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  font-variant-numeric: tabular-nums;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.5rpx;
  white-space: normal;
  word-break: break-all;
  overflow-wrap: anywhere;
}
.appointment-mini-tag {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  color: #566477;
  padding: 5rpx 0;
  font-size: 23rpx;
  line-height: 1.5;
}
.appointment-text {
  font-weight: 500;
  white-space: nowrap;
}
.card-title-row .status-tag,
.card-title-row .status-tag.active,
.card-title-row .status-tag.pending,
.card-title-row .status-tag.completed {
  flex-shrink: 0;
  min-height: 0;
  max-width: none !important;
  background: #edf1f6;
  color: #253d5a;
  border: 0;
  border-radius: 6rpx;
  padding: 7rpx 12rpx;
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 650;
  white-space: nowrap !important;
  word-break: keep-all;
  overflow-wrap: normal;
}
.shipment-meta-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  column-gap: 24rpx;
  row-gap: 6rpx;
  margin-top: 14rpx;
  color: #657184;
  font-size: 24rpx;
  line-height: 1.5;
}
.shipment-subtitle { min-width: 0; word-break: break-all; }
.appointment-time {
  color: #657184;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.card-body { margin-bottom: 20rpx; }
.info-grid { display: flex; flex-direction: column; gap: 10rpx; margin-bottom: 20rpx; }
.info-item { display: flex; align-items: flex-start; gap: 16rpx; min-width: 0; }
.info-k { width: 150rpx; flex-shrink: 0; color: #6a7687; font-size: 24rpx; line-height: 1.5; }
.info-v { flex: 1; min-width: 0; color: #3e4e63; font-size: 25rpx; font-weight: 500; line-height: 1.45; word-break: break-all; }
.mono { font-family: "SFMono-Regular", Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; }
.cargo-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f5f7f9;
  border: 0;
  border-radius: 10rpx;
  padding: 16rpx 10rpx;
}
.cargo-cell { flex: 1; min-width: 0; display: flex; align-items: baseline; justify-content: center; flex-wrap: wrap; gap: 6rpx; }
.cargo-num { color: #34465d; font-size: 27rpx; font-weight: 650; line-height: 1.3; word-break: break-all; }
.cargo-unit { color: #6a7687; font-size: 22rpx; line-height: 1.4; word-break: normal; }
.cargo-divider { width: 1rpx; height: 24rpx; background: #dde3ea; margin: 0 10rpx; }

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  border-top: 1rpx solid #edf0f4;
  padding-top: 14rpx;
}
.create-time { color: #6a7687; font-size: 22rpx; font-weight: 400; font-variant-numeric: tabular-nums; }
.footer-right { display: flex; align-items: center; gap: 14rpx; margin-left: auto; }
.amount { color: #192b43; font-size: 30rpx; font-weight: 650; }
.amount-unquoted { color: #6a7687; font-size: 24rpx; font-weight: 400; }
.delete-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 78rpx;
  min-height: 72rpx;
  margin: -10rpx -12rpx -10rpx 0;
  padding: 16rpx 12rpx;
  color: #657184;
  background: transparent;
  border: 0;
  border-radius: 6rpx;
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 400;
}

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 120rpx 40rpx; }
.empty-icon { margin-bottom: 24rpx; }
.empty-text { color: #34465d; font-size: 32rpx; margin-bottom: 12rpx; }
.empty-hint { color: #657184; font-size: 25rpx; margin-bottom: 36rpx; text-align: center; }
.empty-btn { background: #253d5a; color: #fff; padding: 20rpx 72rpx; border-radius: 10rpx; font-size: 28rpx; }
.loading-state { display: flex; flex-direction: column; align-items: center; padding: 160rpx 0; color: #657184; font-size: 28rpx; }
.loading-spinner { width: 48rpx; height: 48rpx; border: 4rpx solid #e1e6ee; border-top-color: #253d5a; border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 20rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
