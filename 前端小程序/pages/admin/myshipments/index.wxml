<view class="container">
  <!-- 顶部提示 -->
  <view class="tip-bar">
    <text class="tip-text" wx:if="{{isAdmin}}">按月份显示全部运单，新录入的订单自动出现在此处</text>
    <text class="tip-text" wx:else>显示您创建的所有运单，新录入的订单自动出现在此处</text>
  </view>

  <!-- 运单列表 -->
  <view class="shipment-list" wx:if="{{!loading}}">
    <view wx:for="{{shipmentGroups}}" wx:key="monthKey" wx:for-item="group" class="month-section">
      <view class="month-header">
        <text class="month-title">{{group.monthLabel}}</text>
        <text class="month-count">{{group.count}} 单</text>
      </view>

      <view
        wx:for="{{group.list}}"
        wx:key="_id"
        wx:for-item="item"
        class="shipment-card"
        bindtap="goToDetail"
        data-id="{{item._id}}"
      >
        <view class="card-header">
          <view class="card-title-block">
            <text class="shipment-id">{{item.cargoInfo.warehouseEntryNo || item.cargoInfo.waybillNo || item._id}}</text>
            <text class="shipment-subtitle">{{item._routeLabel}}</text>
          </view>
          <view class="card-tags">
            <view class="status-tag {{item.status}}">{{item.currentNodeName || '运输中'}}</view>
            <view class="appointment-mini-tag {{item.appointmentTagClass}}">{{item.appointmentTagText}}</view>
          </view>
        </view>

        <view class="card-body">
          <view class="info-grid">
            <view class="info-item">
              <text class="info-k">{{item.creatorRoleLabel}}</text>
              <text class="info-v">{{item.creatorName || '——'}}</text>
            </view>
            <view class="info-item">
              <text class="info-k">业务参与编号</text>
              <text class="info-v mono">{{item.cargoInfo.waybillNo || '——'}}</text>
            </view>
          </view>
          <view class="cargo-strip">
            <view class="cargo-cell">
              <text class="cargo-num">{{item.cargoInfo.pieces || '-'}}</text>
              <text class="cargo-unit">{{item.cargoInfo.piecesUnit || '件'}}</text>
            </view>
            <view class="cargo-divider"></view>
            <view class="cargo-cell">
              <text class="cargo-num">{{item.cargoInfo.grossWeight || '-'}}</text>
              <text class="cargo-unit">{{item.cargoInfo.weightUnit || 'KGS'}}</text>
            </view>
            <view class="cargo-divider"></view>
            <view class="cargo-cell">
              <text class="cargo-num">{{item.cargoInfo.volume || '-'}}</text>
              <text class="cargo-unit">{{item.cargoInfo.volumeUnit || 'CBM'}}</text>
            </view>
          </view>
        </view>

        <view class="card-footer">
          <text class="create-time">{{item._createdTimeText}}</text>
          <view class="footer-right">
            <text class="amount" wx:if="{{item.totalAmount > 0}}">¥{{item.totalAmount}}</text>
            <text class="amount-unquoted" wx:else>未报价</text>
            <text class="delete-btn" wx:if="{{isAdmin}}" catchtap="deleteShipment" data-id="{{item._id}}">删除</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{shipments.length === 0}}">
      <view class="empty-icon empty-line-icon"></view>
      <text class="empty-text">暂无运单</text>
      <text class="empty-hint">在"建单"页面录入订单后会自动显示</text>
      <view class="empty-btn" bindtap="goToCreate">去建单</view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
</view>
