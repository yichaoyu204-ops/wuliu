<view class="container">
  <!-- 货物信息卡片 -->
  <view wx:if="{{shipment}}" class="info-card">
    <view class="info-row">
      <text class="info-label">进仓编号</text>
      <text class="info-value mono">{{shipment.cargoInfo.warehouseEntryNo || '——'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">业务参与编号</text>
      <text class="info-value mono">{{shipment.cargoInfo.waybillNo || '——'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">{{shipment.creatorRole === 'admin' ? '建单管理员' : '建单业务员'}}</text>
      <text class="info-value">{{shipment.creatorName || '——'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">进仓申报</text>
      <text class="info-value hint">{{shipment.cargoInfo.pieces}}{{shipment.cargoInfo.piecesUnit}} / {{shipment.cargoInfo.grossWeight}}{{shipment.cargoInfo.weightUnit}} / {{shipment.cargoInfo.volume}}{{shipment.cargoInfo.volumeUnit}}</text>
    </view>
  </view>

  <!-- 实测录入表单 -->
  <view class="section">
    <text class="section-title">实际测量数据</text>
    <text class="section-hint">以下数据将用于自动计算运费，请如实填写</text>

    <view class="field-group">
      <view class="field">
        <text class="label">实测件数（整数）</text>
        <input class="input" type="number" placeholder="与申报不符时请修改" data-field="pieces" bindinput="onFormInput" value="{{form.pieces}}" />
      </view>

      <view class="field field-with-unit">
        <text class="label">实测重量 *</text>
        <view class="input-unit-row">
          <input class="input flex1" type="digit" placeholder="必填" data-field="weight" bindinput="onFormInput" value="{{form.weight}}" />
          <text class="unit-tag">{{form.weightUnit}}</text>
        </view>
      </view>

      <view class="field field-with-unit">
        <text class="label">实测体积 *</text>
        <view class="input-unit-row">
          <input class="input flex1" type="digit" placeholder="必填，差异大系统会提醒" data-field="volume" bindinput="onFormInput" value="{{form.volume}}" />
          <text class="unit-tag">{{form.volumeUnit}}</text>
        </view>
      </view>

      <view class="field">
        <text class="label">备注（可选）</text>
        <input class="input" placeholder="如：货物完好/轻微破损" data-field="note" bindinput="onFormInput" value="{{form.note}}" maxlength="50" />
      </view>
    </view>
  </view>

  <!-- 费用计算 -->
  <view class="section" wx:if="{{shipment}}">
    <text class="section-title">费用计算</text>

    <!-- 主体费用（自动计算） -->
    <view class="fee-group">
      <view class="fee-group-title">主体费用</view>
      <view class="fee-row" wx:for="{{mainFees}}" wx:key="name">
        <view class="fee-left">
          <text class="fee-name">{{item.name}}</text>
          <text class="fee-detail" wx:if="{{item.detail}}">{{item.detail}}</text>
        </view>
        <view wx:if="{{item.code === 'main_distribution'}}" class="main-fee-edit">
          <text class="fee-currency">¥</text>
          <input
            class="inline-input main-fee-input"
            type="digit"
            value="{{distributionFee.inputAmount}}"
            bindinput="onDistributionAmountChange"
          />
        </view>
        <text wx:else class="fee-amount">¥{{item.amount}}</text>
      </view>
    </view>

    <!-- 代收款 -->
    <view class="fee-group">
      <view class="fee-group-title collection-group-title">代收款</view>
      <view class="extra-fee-item">
        <view class="extra-fee-header" bindtap="toggleCollectionFee">
          <view class="checkbox {{collectionFee.enabled ? 'checked' : ''}}">
            <text wx:if="{{collectionFee.enabled}}">✓</text>
          </view>
          <text class="extra-fee-name">代收款</text>
          <text class="extra-fee-amount" wx:if="{{collectionFee.enabled}}">¥{{collectionFee.amount}}</text>
        </view>
        <view class="extra-fee-body" wx:if="{{collectionFee.enabled}}">
          <view class="sub-fee-row" wx:for="{{collectionItems}}" wx:key="name">
            <text class="sub-fee-name">{{item.name}}</text>
            <view class="sub-fee-inputs">
              <input class="sub-input price" type="digit" value="{{item.price}}" bindinput="onCollectionPriceChange" data-idx="{{index}}" />
              <text class="sub-unit">元/{{item.unit}}</text>
              <text class="sub-multiply">×</text>
              <input wx:if="{{!item.qtySource}}" class="sub-input qty" type="digit" value="{{item.qty}}" bindinput="onCollectionQtyChange" data-idx="{{index}}" />
              <text wx:else class="sub-input qty">{{item.qty || 0}}</text>
              <text class="sub-unit">{{item.unit}}</text>
              <text class="sub-equals">=</text>
              <text class="sub-amount">¥{{item.amount}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 附加费用 -->
    <view class="fee-group">
      <view class="fee-group-title">附加费用</view>

      <!-- 其他-北仑分拨费 -->
      <view class="extra-fee-item">
        <view class="extra-fee-header" bindtap="toggleExtraFee" data-idx="0">
          <view class="checkbox {{extraFees[0].enabled ? 'checked' : ''}}">
            <text wx:if="{{extraFees[0].enabled}}">✓</text>
          </view>
          <text class="extra-fee-name">其他-北仑分拨费</text>
          <text class="extra-fee-amount" wx:if="{{extraFees[0].enabled}}">¥{{extraFees[0].amount}}</text>
        </view>
        <view class="extra-fee-body" wx:if="{{extraFees[0].enabled}}">
          <view class="inline-input-row">
            <text>票数</text>
            <input class="inline-input" type="number" value="{{extraFees[0].tickets}}" bindinput="onExtraFeeFieldChange" data-idx="0" data-field="tickets" placeholder="0" />
            <text>票 × 120元/票</text>
          </view>
          <view class="extra-fee-hint">义乌发北仑下货点后再小车分拨，属于附加费用</view>
        </view>
      </view>

      <!-- 上门提货费 -->
      <view class="extra-fee-item">
        <view class="extra-fee-header" bindtap="toggleExtraFee" data-idx="1">
          <view class="checkbox {{extraFees[1].enabled ? 'checked' : ''}}">
            <text wx:if="{{extraFees[1].enabled}}">✓</text>
          </view>
          <text class="extra-fee-name">上门提货费</text>
          <text class="extra-fee-amount" wx:if="{{extraFees[1].enabled}}">¥{{extraFees[1].amount}}</text>
        </view>
        <view class="extra-fee-body" wx:if="{{extraFees[1].enabled}}">
          <view class="inline-input-row">
            <text>提货次数</text>
            <input class="inline-input" type="number" value="{{extraFees[1].times}}" bindinput="onExtraFeeFieldChange" data-idx="1" data-field="times" placeholder="0" />
            <text>次 × 50元/次</text>
          </view>
        </view>
      </view>

      <!-- 堆存费 -->
      <view class="extra-fee-item">
        <view class="extra-fee-header" bindtap="toggleExtraFee" data-idx="2">
          <view class="checkbox {{extraFees[2].enabled ? 'checked' : ''}}">
            <text wx:if="{{extraFees[2].enabled}}">✓</text>
          </view>
          <text class="extra-fee-name">堆存费</text>
          <text class="extra-fee-amount" wx:if="{{extraFees[2].enabled}}">¥{{extraFees[2].amount}}</text>
        </view>
        <view class="extra-fee-body" wx:if="{{extraFees[2].enabled}}">
          <view class="inline-input-row">
            <text>存放天数</text>
            <input class="inline-input" type="number" value="{{extraFees[2].days}}" bindinput="onExtraFeeFieldChange" data-idx="2" data-field="days" placeholder="0" />
            <text>天（5天内免费，超过部分50元/票/天）</text>
          </view>
        </view>
      </view>

      <!-- 贴唛改唛费 -->
      <view class="extra-fee-item">
        <view class="extra-fee-header" bindtap="toggleExtraFee" data-idx="3">
          <view class="checkbox {{extraFees[3].enabled ? 'checked' : ''}}">
            <text wx:if="{{extraFees[3].enabled}}">✓</text>
          </view>
          <text class="extra-fee-name">贴唛改唛费</text>
          <text class="extra-fee-amount" wx:if="{{extraFees[3].enabled}}">¥{{extraFees[3].amount}}</text>
        </view>
        <view class="extra-fee-body" wx:if="{{extraFees[3].enabled}}">
          <view class="inline-input-row">
            <text>件数</text>
            <input class="inline-input" type="number" value="{{extraFees[3].pieces}}" bindinput="onExtraFeeFieldChange" data-idx="3" data-field="pieces" placeholder="0" />
            <text>件 × 2元/件</text>
          </view>
        </view>
      </view>

      <!-- 义乌地区转运费 -->
      <view class="extra-fee-item">
        <view class="extra-fee-header" bindtap="toggleExtraFee" data-idx="4">
          <view class="checkbox {{extraFees[4].enabled ? 'checked' : ''}}">
            <text wx:if="{{extraFees[4].enabled}}">✓</text>
          </view>
          <text class="extra-fee-name">义乌地区转运费</text>
          <text class="extra-fee-amount" wx:if="{{extraFees[4].enabled}}">¥{{extraFees[4].amount}}</text>
        </view>
        <view wx:if="{{extraFees[4].enabled}}">
          <view class="extra-fee-hint">
            小于5方180元/次 | 5-9.99方220元/次 | 10-20方280元/次 | 大于20方单独报价
          </view>
          <view class="inline-input-row" wx:if="{{extraFees[4].needsCustom}}">
            <text>单独报价</text>
            <input class="inline-input" type="digit" value="{{extraFees[4].customAmount}}" bindinput="onExtraFeeFieldChange" data-idx="4" data-field="customAmount" placeholder="0" />
            <text>元</text>
          </view>
        </view>
      </view>

      <!-- 非义乌地区转运费 -->
      <view class="extra-fee-item">
        <view class="extra-fee-header" bindtap="toggleExtraFee" data-idx="5">
          <view class="checkbox {{extraFees[5].enabled ? 'checked' : ''}}">
            <text wx:if="{{extraFees[5].enabled}}">✓</text>
          </view>
          <text class="extra-fee-name">非义乌地区转运费</text>
          <text class="extra-fee-amount" wx:if="{{extraFees[5].enabled}}">¥{{extraFees[5].amount}}</text>
        </view>
        <view class="extra-fee-body" wx:if="{{extraFees[5].enabled}}">
          <view class="inline-input-row">
            <text>单独报价</text>
            <input class="inline-input" type="digit" value="{{extraFees[5].customAmount}}" bindinput="onExtraFeeFieldChange" data-idx="5" data-field="customAmount" placeholder="0" />
            <text>元</text>
          </view>
        </view>
      </view>

      <!-- 其他杂费 -->
      <view class="extra-fee-item">
        <view class="extra-fee-header" bindtap="toggleExtraFee" data-idx="6">
          <view class="checkbox {{extraFees[6].enabled ? 'checked' : ''}}">
            <text wx:if="{{extraFees[6].enabled}}">✓</text>
          </view>
          <text class="extra-fee-name">其他杂费</text>
          <text class="extra-fee-amount" wx:if="{{extraFees[6].enabled}}">¥{{extraFees[6].amount}}</text>
        </view>
        <view class="extra-fee-body" wx:if="{{extraFees[6].enabled}}">
          <view class="inline-input-row">
            <text>费用名称</text>
            <input class="inline-input wide" type="text" value="{{extraFees[6].customName}}" bindinput="onExtraFeeFieldChange" data-idx="6" data-field="customName" placeholder="如：加急费" />
          </view>
          <view class="inline-input-row">
            <text>金额</text>
            <input class="inline-input" type="digit" value="{{extraFees[6].customAmount}}" bindinput="onExtraFeeFieldChange" data-idx="6" data-field="customAmount" placeholder="0" />
            <text>元</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 费用总计 -->
    <view class="fee-total-bar">
      <text class="fee-total-label">费用合计</text>
      <text class="fee-total-amount">¥{{totalAmount}}</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="footer">
    <view
      class="submit-btn {{submitting ? 'btn-disabled' : ''}}"
      bindtap="submit"
    >
      {{submitting ? '提交中...' : '保存并生成报价单'}}
    </view>
  </view>

  <!-- 供应商现结支付弹窗 -->
  <view class="pay-modal" wx:if="{{showPayModal}}">
    <view class="pay-mask" bindtap="closePayModal"></view>
    <view class="pay-content">
      <view class="pay-title">现场扫码收款</view>
      <view class="pay-amount">¥{{payAmount}}</view>
      <view class="pay-hint">请向客户展示收款码，点击图片可放大</view>
      <scroll-view scroll-y class="pay-qr-list">
        <view
          class="pay-qr-card {{item.type}}"
          wx:for="{{paymentQrs}}"
          wx:key="type"
          bindtap="previewPaymentQr"
          data-url="{{item.url}}"
        >
          <view class="pay-qr-head">
            <text class="pay-qr-name">{{item.name}}</text>
            <text class="pay-qr-hint">{{item.hint}}</text>
          </view>
          <image class="pay-qr-image" src="{{item.url}}" mode="aspectFit" />
        </view>
      </scroll-view>
      <view class="pay-actions">
        <view class="pay-btn pay-btn-secondary" bindtap="closePayModal">取消</view>
        <view class="pay-btn pay-btn-primary {{confirmingPaid ? 'btn-disabled' : ''}}" bindtap="confirmPaid">
          {{confirmingPaid ? '确认中...' : '确认已收款'}}
        </view>
      </view>
    </view>
  </view>
</view>
