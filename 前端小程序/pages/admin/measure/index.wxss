.container {
  padding: 24rpx;
  background: #f4f6fa;
  min-height: 100vh;
  padding-bottom: 160rpx;
}

/* 货物信息卡 */
.info-card {
  background: #e8f0fe;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border-left: 6rpx solid #2156f3;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.info-label {
  font-size: 25rpx;
  color: #344156;
  width: 120rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 26rpx;
  color: #171b22;
  font-weight: 500;
}

.info-value.hint {
  color: #596577;
  font-size: 25rpx;
}

.mono {
  font-family: monospace;
}

/* 分区 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #171b22;
  display: block;
  margin-bottom: 6rpx;
}

.section-hint {
  font-size: 25rpx;
  color: #596577;
  display: block;
  margin-bottom: 24rpx;
}

/* 表单 */
.field {
  margin-bottom: 24rpx;
}

.label {
  font-size: 26rpx;
  color: #344156;
  display: block;
  margin-bottom: 10rpx;
}

.input {
  border: 1rpx solid #e1e6ee;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: #171b22;
  background: #f4f6fa;
  width: 100%;
  box-sizing: border-box;
  height: 80rpx;
  line-height: 80rpx;
}

.input-unit-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.flex1 {
  flex: 1;
}

.unit-tag {
  background: #e8f0fe;
  color: #2156f3;
  font-size: 25rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

/* 费用计算 */
.fee-group {
  margin-bottom: 24rpx;
}

.fee-group-title {
  font-size: 26rpx;
  color: #596577;
  margin-bottom: 12rpx;
  display: block;
}

.collection-group-title {
  font-size: 28rpx;
  color: #171b22;
}

.fee-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.fee-left {
  flex: 1;
  margin-right: 16rpx;
}

.fee-name {
  font-size: 28rpx;
  color: #171b22;
  display: block;
}

.fee-detail {
  font-size: 25rpx;
  color: #596577;
  margin-top: 4rpx;
  display: block;
}

.fee-amount {
  font-size: 28rpx;
  color: #E53935;
  font-weight: 500;
  white-space: nowrap;
}

.main-fee-edit {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.fee-currency {
  font-size: 28rpx;
  color: #E53935;
  font-weight: 500;
}

.main-fee-input {
  width: 120rpx;
  color: #E53935;
  font-weight: 600;
}

/* 附加费用项 */
.extra-fee-item {
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #f4f6fa;
  border-radius: 12rpx;
}

.extra-fee-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #e1e6ee;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  color: #fff;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #2156f3;
  border-color: #2156f3;
}

.extra-fee-name {
  flex: 1;
  font-size: 28rpx;
  color: #171b22;
}

.extra-fee-amount {
  font-size: 28rpx;
  color: #E53935;
  font-weight: 500;
}

.extra-fee-hint {
  font-size: 25rpx;
  color: #596577;
  margin-top: 8rpx;
  margin-left: 48rpx;
}

.extra-fee-body {
  margin-top: 12rpx;
  margin-left: 48rpx;
}

/* 子费用行 */
.sub-fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #e1e6ee;
}

.sub-fee-name {
  font-size: 26rpx;
  color: #344156;
  width: 120rpx;
  flex-shrink: 0;
}

.sub-fee-inputs {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  justify-content: flex-end;
}

.sub-input {
  border: 1rpx solid #e1e6ee;
  border-radius: 8rpx;
  padding: 6rpx 10rpx;
  font-size: 25rpx;
  text-align: center;
  background: #fff;
}

.sub-input.price {
  width: 100rpx;
}

.sub-input.qty {
  width: 80rpx;
}

.sub-unit {
  font-size: 25rpx;
  color: #596577;
}

.sub-multiply, .sub-equals {
  font-size: 25rpx;
  color: #596577;
}

.sub-amount {
  font-size: 26rpx;
  color: #E53935;
  font-weight: 500;
  min-width: 80rpx;
  text-align: right;
}

/* 行内输入 */
.inline-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: #344156;
}

.inline-input {
  border: 1rpx solid #e1e6ee;
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  font-size: 26rpx;
  width: 120rpx;
  text-align: center;
  background: #fff;
}

.inline-input.wide {
  width: 240rpx;
}

/* 费用总计 */
.fee-total-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-top: 2rpx solid #2156f3;
  margin-top: 16rpx;
}

.fee-total-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #171b22;
}

.fee-total-amount {
  font-size: 40rpx;
  font-weight: bold;
  color: #E53935;
}

/* 底部提交 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e1e6ee;
}

.submit-btn {
  background: #2156f3;
  color: #fff;
  text-align: center;
  padding: 28rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-disabled {
  background: #aac4f0;
}

/* 支付弹窗 */
.pay-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pay-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.6);
}

.pay-content {
  position: relative;
  background: #fff;
  border-radius: 12rpx;
  padding: 40rpx 32rpx 32rpx;
  width: 620rpx;
  max-height: 86vh;
  text-align: center;
  z-index: 1;
}

.pay-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #171b22;
  margin-bottom: 24rpx;
}

.pay-amount {
  font-size: 56rpx;
  font-weight: bold;
  color: #E53935;
  margin-bottom: 16rpx;
}

.pay-hint {
  font-size: 26rpx;
  color: #596577;
  margin-bottom: 24rpx;
}

.pay-qr-list {
  max-height: 760rpx;
  margin-bottom: 28rpx;
}

.pay-qr-card {
  border: 1rpx solid #e1e6ee;
  border-radius: 18rpx;
  background: #f4f6fa;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.pay-qr-card.wechat {
  border-color: #c8efd8;
}

.pay-qr-card.alipay {
  border-color: #c9ddff;
}

.pay-qr-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.pay-qr-name {
  font-size: 30rpx;
  color: #171b22;
  font-weight: 700;
}

.pay-qr-hint {
  font-size: 25rpx;
  color: #596577;
}

.pay-qr-image {
  width: 100%;
  height: 430rpx;
  display: block;
  background: #fff;
  border-radius: 12rpx;
}

.pay-actions {
  display: flex;
  gap: 24rpx;
}

.pay-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
}

.pay-btn-secondary {
  background: #f4f6fa;
  color: #596577;
}

.pay-btn-primary {
  background: #2156f3;
  color: #fff;
}

@import "../../../styles/ui.wxss";


@import "../../../styles/forms.wxss";
