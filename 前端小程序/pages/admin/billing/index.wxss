@import "../../../styles/ui.wxss";

/* 管理员账单：总览、独立账单卡、金额与费用明细。 */
.container { min-height: 100vh; box-sizing: border-box; background: #EDF1F7; color: #171B22; font-size: 28rpx; line-height: 1.5; }
.page-heading { margin: 0; padding: 44rpx 40rpx 10rpx; background: #FFFFFF; color: #171B22; font-size: 54rpx; line-height: 1.25; font-weight: 650; letter-spacing: -1.5rpx; }
.page-description { padding: 0 40rpx 30rpx; color: #596577; background: #FFFFFF; font-size: 26rpx; line-height: 1.6; }
.tab-bar { display: flex; background: #FFFFFF; border-bottom: 1rpx solid #DCE4EF; position: sticky; top: 0; z-index: 100; padding: 0 24rpx; box-shadow: 0 6rpx 16rpx rgba(19,39,73,.04); }
.tab-item { flex: 1; min-width: 0; min-height: 96rpx; padding: 24rpx 12rpx; position: relative; text-align: center; font-size: 28rpx; line-height: 1.5; color: #596577; transition: opacity .18s ease, background-color .18s ease; box-sizing: border-box; }
.tab-active { color: #2156F3; font-weight: 650; }
.tab-active::after { content: ''; position: absolute; bottom: 0; left: 50%; width: 52rpx; height: 5rpx; transform: translateX(-50%); background: #2156F3; border-radius: 1rpx; }
.bill-list { padding: 28rpx 24rpx calc(124rpx + env(safe-area-inset-bottom)); }
.bill-card { margin-bottom: 30rpx; padding: 0 26rpx 28rpx; overflow: hidden; background: #FFFFFF; border: 1rpx solid #CBD6E5; border-radius: 18rpx; box-shadow: 0 6rpx 18rpx rgba(25,45,78,.05); }
.bill-header { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin: 0 -26rpx 24rpx; padding: 20rpx 26rpx; background: #EAF0FC; border-bottom: 1rpx solid #D4DFF3; border-left: 6rpx solid #2156F3; }
.bill-number { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.bill-caption { color: #526680; font-size: 22rpx; line-height: 1.4; font-weight: 500; }
.bill-id { min-width: 0; color: #18395F; font-size: 28rpx; font-weight: 650; line-height: 1.4; letter-spacing: -.3rpx; font-variant-numeric: tabular-nums; word-break: break-all; }
.bill-status { flex-shrink: 0; padding: 7rpx 14rpx; border-radius: 7rpx; border: 1rpx solid transparent; color: #596577; background: #F0F3F8; font-size: 25rpx; font-weight: 600; line-height: 1.4; white-space: nowrap !important; word-break: keep-all; }
.bill-status.unpaid { color: #8A4B0F; background: #FFF4E2; border-color: #ECD5AF; }
.bill-status.paid { color: #176451; background: #E7F4EE; border-color: #C6E2D7; }
.bill-status.muted { color: #526680; background: #F0F3F8; border-color: #D8E0EB; }
.bill-factory { margin-bottom: 8rpx; color: #172A46; font-size: 32rpx; font-weight: 600; line-height: 1.5; word-break: break-all; }
.bill-time { margin-bottom: 20rpx; color: #66758A; font-size: 24rpx; line-height: 1.5; font-variant-numeric: tabular-nums; }
.bill-footer { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16rpx; margin: 22rpx 0 0; padding: 22rpx 20rpx; background: #F3F6FC; border: 1rpx solid #E0E7F2; border-radius: 12rpx; }
.bill-type { color: #345577; background: #FFFFFF; border: 1rpx solid #D7E1EF; border-radius: 7rpx; padding: 7rpx 12rpx; font-size: 25rpx; line-height: 1.4; }
.amount-caption { margin-bottom: 6rpx; color: #5E6F85; font-size: 22rpx; line-height: 1.4; }
.amount-stack, .fee-total-stack { display: flex; flex-direction: column; align-items: flex-end; min-width: 0; max-width: 100%; line-height: 1.4; word-break: break-all; }
.bill-amount { max-width: 100%; color: #1745C8; font-size: 52rpx; font-weight: 650; letter-spacing: -1rpx; line-height: 1.2; font-variant-numeric: tabular-nums; }
.bill-original, .fee-original-amount { margin-bottom: 6rpx; color: #596577; font-size: 25rpx; text-decoration: line-through; }
.detail-title { display: flex; align-items: center; gap: 12rpx; margin-bottom: 20rpx; color: #243E60; font-size: 26rpx; line-height: 1.5; font-weight: 650; }
.detail-title::before { content: ''; display: block; width: 5rpx; height: 24rpx; flex-shrink: 0; background: #4E74BB; border-radius: 2rpx; }
.fee-detail { margin-bottom: 24rpx; padding: 20rpx; background: #F8FAFD; border: 1rpx solid #E0E7F2; border-radius: 12rpx; }
.fee-detail .detail-title { margin-bottom: 0; padding-bottom: 16rpx; border-bottom: 1rpx solid #D9E2EF; }
.fee-row { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; padding: 20rpx 0; border-bottom: 1rpx solid #E1E6ED; }
.fee-info { flex: 1 1 220rpx; min-width: 0; display: flex; flex-direction: column; }
.fee-name { font-size: 27rpx; font-weight: 500; color: #243E60; line-height: 1.5; word-break: break-all; }
.fee-calc { margin-top: 7rpx; font-size: 25rpx; color: #596577; line-height: 1.55; word-break: break-all; }
.fee-amount { flex-shrink: 0; max-width: 100%; color: #171B22; font-size: 29rpx; font-weight: 600; line-height: 1.5; font-variant-numeric: tabular-nums; word-break: break-all; }
.fee-excluded { color: #596577; font-weight: 400; text-decoration: line-through; }
.fee-total-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; padding-top: 22rpx; }
.fee-total-label { color: #344156; font-size: 28rpx; font-weight: 500; }
.fee-total-amount { color: #171B22; font-size: 36rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.discount-summary { margin: 0 0 24rpx; padding: 14rpx 16rpx; background: #EEF2FF; color: #1745C8; border: 1rpx solid #DDE5FF; border-radius: 8rpx; font-size: 25rpx; line-height: 1.5; word-break: break-all; }
.bill-actions { display: flex; gap: 12rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #E0E7F2; }
.discount-btn, .mark-paid-btn { flex: 1; min-width: 0; min-height: 88rpx; padding: 20rpx 14rpx; display: flex; align-items: center; justify-content: center; border-radius: 10rpx; font-size: 28rpx; line-height: 1.45; font-weight: 600; text-align: center; box-sizing: border-box; transition: transform .18s ease, opacity .18s ease; }
.discount-btn { flex: 0 1 152rpx; background: #FFFFFF; color: #344156; border: 1rpx solid #D8E0EB; }
.mark-paid-btn { background: #2156F3; color: #FFFFFF; border: 1rpx solid #2156F3; }
.mark-paid-btn.btn-disabled { opacity: .5; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 96rpx 28rpx; background: #FFFFFF; border: 1rpx solid #E1E6ED; border-radius: 14rpx; text-align: center; }
.empty-text { font-size: 30rpx; color: #344156; line-height: 1.5; }
.loading-state { padding: 120rpx 28rpx; text-align: center; color: #596577; font-size: 28rpx; }
.modal-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(23,27,34,.48); z-index: 998; }
.modal-content { position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: calc(100vw - 48rpx); max-width: 680rpx; max-height: calc(100vh - 96rpx); overflow-y: auto; padding: 36rpx 30rpx 30rpx; box-sizing: border-box; background: #FFFFFF; border: 1rpx solid #E1E6ED; border-radius: 16rpx; z-index: 999; animation: core-modal-in .18s ease-out both; }
.modal-title { margin-bottom: 28rpx; color: #171B22; font-size: 36rpx; line-height: 1.3; font-weight: 650; text-align: center; }
.discount-bill-info { display: flex; flex-direction: column; padding: 22rpx; margin-bottom: 24rpx; background: #F4F6FA; border-radius: 10rpx; }
.discount-bill-id { color: #344156; font-size: 25rpx; word-break: break-all; line-height: 1.5; }
.discount-bill-amount { margin-top: 10rpx; color: #171B22; font-size: 32rpx; font-weight: 600; line-height: 1.5; font-variant-numeric: tabular-nums; }
.discount-mode-row { display: flex; gap: 12rpx; margin-bottom: 24rpx; }
.discount-mode { flex: 1; min-height: 80rpx; padding: 18rpx 10rpx; text-align: center; border-radius: 8rpx; background: #F4F6FA; color: #596577; border: 1rpx solid #E1E6ED; font-size: 28rpx; line-height: 1.5; font-weight: 500; box-sizing: border-box; }
.discount-mode-active { background: #EEF2FF; color: #2156F3; border-color: #2156F3; font-weight: 600; }
.modal-row { display: flex; align-items: center; gap: 20rpx; margin-bottom: 16rpx; }
.modal-label { width: 96rpx; flex-shrink: 0; font-size: 28rpx; color: #344156; }
.modal-input { flex: 1; min-width: 0; box-sizing: border-box; height: 88rpx; line-height: 88rpx; padding: 0 20rpx; color: #171B22; background: #F4F6FA; border: 1rpx solid #D8E0EB; border-radius: 8rpx; font-size: 30rpx; }
.discount-tip { margin: 0 0 20rpx 116rpx; color: #596577; font-size: 25rpx; line-height: 1.5; }
.discount-preview { margin-top: 16rpx; padding: 16rpx 18rpx; color: #1745C8; background: #EEF2FF; border-radius: 8rpx; font-size: 26rpx; line-height: 1.5; }
.modal-actions { display: flex; gap: 14rpx; margin-top: 28rpx; }
.modal-btn-cancel, .modal-btn-confirm { flex: 1; min-height: 88rpx; padding: 20rpx 10rpx; display: flex; align-items: center; justify-content: center; border-radius: 10rpx; font-size: 28rpx; line-height: 1.45; text-align: center; font-weight: 600; box-sizing: border-box; transition: transform .18s ease, opacity .18s ease; }
.modal-btn-cancel { background: #F3F5F9; color: #344156; border: 1rpx solid #E1E6ED; }
.modal-btn-confirm { background: #2156F3; color: #FFFFFF; }
.modal-btn-confirm.btn-disabled { opacity: .5; }
@keyframes core-modal-in { from { opacity: 0; } to { opacity: 1; } }
@media (max-width: 350px) { .page-heading { padding-left: 28rpx; padding-right: 28rpx; } .page-description { padding-left: 28rpx; padding-right: 28rpx; } .bill-list { padding-left: 20rpx; padding-right: 20rpx; } .bill-amount { font-size: 46rpx; } .bill-id { font-size: 27rpx; } .month-title { font-size: 30rpx; } }
@media (prefers-reduced-motion: reduce) { .modal-content { animation: none; } .mark-paid-btn, .discount-btn, .modal-btn-cancel, .modal-btn-confirm, .tab-item { transition: none; } }

.stats-bar { display: flex; margin: 24rpx 24rpx 0; padding: 28rpx 12rpx; background: #172A46; border: 1rpx solid #263E5F; border-radius: 16rpx; }
.stats-item { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; padding: 0 20rpx; }
.stats-label { margin-bottom: 12rpx; color: #C4D2E5; font-size: 25rpx; line-height: 1.5; }
.stats-amount { max-width: 100%; color: #FFFFFF; font-size: 40rpx; font-weight: 650; line-height: 1.3; letter-spacing: -.6rpx; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.stats-amount.unpaid { color: #FFDB9F; }
.stats-divider { width: 1rpx; flex-shrink: 0; background: #425673; }
.action-bar { padding: 20rpx 24rpx 24rpx; }
.btn-monthly { min-height: 88rpx; padding: 20rpx; display: flex; align-items: center; justify-content: center; background: #2156F3; border: 1rpx solid #2156F3; border-radius: 12rpx; color: #FFFFFF; font-size: 29rpx; font-weight: 600; line-height: 1.45; box-sizing: border-box; }
.bill-phone { margin-bottom: 22rpx; color: #66758A; font-size: 25rpx; line-height: 1.5; overflow-wrap: anywhere; }
.modal-label { width: 152rpx; }
.modal-row picker { flex: 1; min-width: 0; }
.modal-picker { position: relative; min-height: 88rpx; display: flex; align-items: center; padding: 16rpx 48rpx 16rpx 20rpx; border: 1rpx solid #AFC4EE; border-radius: 8rpx; background: #EEF3FF; color: #1745C8; font-size: 28rpx; line-height: 1.5; box-sizing: border-box; }
.modal-picker::after { content: ''; position: absolute; right: 22rpx; top: 34rpx; width: 12rpx; height: 12rpx; border-right: 3rpx solid #2156F3; border-bottom: 3rpx solid #2156F3; transform: rotate(45deg); }
.discount-tip { margin-left: 172rpx; }
@media (max-width: 350px) { .stats-item { padding: 0 14rpx; } .stats-amount { font-size: 36rpx; } }
