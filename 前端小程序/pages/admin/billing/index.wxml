<view class="container">
  <!-- 统计卡片 -->
  <view class="stats-bar">
    <view class="stats-item">
      <text class="stats-label">未付总额</text>
      <text class="stats-amount unpaid">¥{{totalUnpaid.toFixed(2)}}</text>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <text class="stats-label">已付总额</text>
      <text class="stats-amount paid">¥{{totalPaid.toFixed(2)}}</text>
    </view>
  </view>

  <!-- 月结操作 -->
  <view class="action-bar">
    <view class="btn-monthly" bindtap="showMonthlyModal">生成月结账单</view>
  </view>

  <!-- Tab -->
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'tab-active' : ''}}"
      bindtap="switchTab"
      data-key="{{item.key}}"
    >{{item.label}}</view>
  </view>

  <!-- 列表 -->
  <view class="bill-list" wx:if="{{!loading}}">
    <view
      wx:for="{{filteredBills}}"
      wx:key="_id"
      class="bill-card"
    >
      <view class="bill-header">
        <text class="bill-id">{{item._id}}</text>
        <text class="bill-status {{item.status}}">{{item.status === 'unpaid' ? '待付' : '已付'}}</text>
      </view>
      <view class="bill-factory">{{item.contacts.contact1Name || '——'}}</view>
      <view class="bill-phone">客户：{{item.clientPhone || '——'}}</view>
      <view class="discount-summary" wx:if="{{item._adminDiscountText}}">
        <text>{{item._adminDiscountText}}</text>
      </view>
      <view class="fee-detail" wx:if="{{item._items && item._items.length > 0}}">
        <view class="fee-row" wx:for="{{item._items}}" wx:for-item="fee" wx:key="index">
          <view class="fee-info">
            <text class="fee-name">{{fee.name}}</text>
            <text class="fee-calc" wx:if="{{fee.calculationDetail}}">{{fee.calculationDetail}}</text>
          </view>
          <text class="fee-amount {{fee.isIncluded === false ? 'fee-excluded' : ''}}">
            {{fee.isIncluded === false ? '未计入 ' : ''}}¥{{fee._amountText}}
          </text>
        </view>
        <view class="fee-total-row">
          <text class="fee-total-label">合计</text>
          <view class="fee-total-stack">
            <text class="fee-original-amount" wx:if="{{item._adminDiscountText}}">原价 ¥{{item._originalAmountText}}</text>
            <text class="fee-total-amount">¥{{item._totalAmountText}}</text>
          </view>
        </view>
      </view>
      <view class="bill-footer">
        <text class="bill-type">{{item.paymentTypeLabel}}</text>
        <view class="amount-stack">
          <text class="bill-original" wx:if="{{item._adminDiscountText}}">原价 ¥{{item._originalAmountText}}</text>
          <text class="bill-amount">¥{{item._totalAmountText}}</text>
        </view>
      </view>
      <view wx:if="{{item.status === 'unpaid'}}" class="bill-actions">
        <view
          class="discount-btn"
          bindtap="showDiscountModal"
          data-id="{{item._id}}"
        >优惠</view>
        <view
          class="mark-paid-btn"
          bindtap="markPaid"
          data-id="{{item._id}}"
        >标记已付</view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{filteredBills.length === 0}}">
      <view class="empty-icon empty-line-icon"></view>
      <text class="empty-text">暂无{{activeTab === 'unpaid' ? '待付' : (activeTab === 'paid' ? '已付' : '')}}账单</text>
    </view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 月结合并弹窗 -->
  <view class="modal-mask" wx:if="{{monthlyModalVisible}}" bindtap="hideMonthlyModal"></view>
  <view class="modal-content" wx:if="{{monthlyModalVisible}}">
    <view class="modal-title">生成月结账单</view>
    <view class="modal-row">
      <text class="modal-label">月份</text>
      <picker mode="date" fields="month" value="{{monthlyBatch}}" bindchange="onMonthlyBatchChange">
        <view class="modal-picker">{{monthlyBatch || '请选择月份'}}</view>
      </picker>
    </view>
    <view class="modal-row">
      <text class="modal-label">客户手机号</text>
      <input class="modal-input" type="number" placeholder="输入客户手机号" value="{{monthlyPhone}}" bindinput="onMonthlyPhoneChange" />
    </view>
    <view class="modal-actions">
      <view class="modal-btn-cancel" bindtap="hideMonthlyModal">取消</view>
      <view class="modal-btn-confirm {{monthlySubmitting ? 'btn-disabled' : ''}}" bindtap="doCreateMonthlyBill">
        {{monthlySubmitting ? '生成中...' : '确认生成'}}
      </view>
    </view>
  </view>

  <!-- 优惠弹窗 -->
  <view class="modal-mask" wx:if="{{discountModalVisible}}" bindtap="hideDiscountModal"></view>
  <view class="modal-content" wx:if="{{discountModalVisible}}">
    <view class="modal-title">账单优惠</view>
    <view class="discount-bill-info">
      <text class="discount-bill-id">{{discountBill._id}}</text>
      <text class="discount-bill-amount">当前应付 ¥{{discountBill._totalAmountText}}</text>
    </view>
    <view class="discount-mode-row">
      <view
        class="discount-mode {{discountMode === 'rate' ? 'discount-mode-active' : ''}}"
        bindtap="switchDiscountMode"
        data-mode="rate"
      >打折</view>
      <view
        class="discount-mode {{discountMode === 'amount' ? 'discount-mode-active' : ''}}"
        bindtap="switchDiscountMode"
        data-mode="amount"
      >减免金额</view>
    </view>
    <view class="modal-row">
      <text class="modal-label">{{discountMode === 'rate' ? '折扣' : '金额'}}</text>
      <input
        class="modal-input"
        type="digit"
        placeholder="{{discountMode === 'rate' ? '例：9、95、9.5' : '输入减免金额'}}"
        value="{{discountValue}}"
        bindinput="onDiscountValueChange"
      />
    </view>
    <view class="discount-tip" wx:if="{{discountMode === 'rate'}}">9 表示 9折，95 表示 95折</view>
    <view class="discount-preview" wx:if="{{discountPreviewText}}">{{discountPreviewText}}</view>
    <view class="modal-actions">
      <view class="modal-btn-cancel" bindtap="hideDiscountModal">取消</view>
      <view class="modal-btn-confirm {{discountSubmitting ? 'btn-disabled' : ''}}" bindtap="doApplyDiscount">
        {{discountSubmitting ? '处理中...' : '确认优惠'}}
      </view>
    </view>
  </view>
</view>
