@import "../../styles/ui.wxss";
/* Selected dark login direction. Existing business branches and handlers remain unchanged. */
.container{min-height:100vh;color:#fff;background:#111d2f;padding:44rpx 44rpx calc(48rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.role-header{position:relative;padding:0;margin:0;border:0;background:transparent;overflow:hidden}
.brand-lockup{display:flex;align-items:center;gap:18rpx;position:relative;z-index:1;min-height:70rpx}
.brand-logo{width:88rpx;height:68rpx;background:url('data:image/png;base64,') center/250% auto no-repeat;flex-shrink:0}
.brand-name{font-size:42rpx;line-height:1.3;font-weight:650;letter-spacing:-.6rpx;color:#fff}
.brand-watermark{position:absolute;right:-60rpx;top:-4rpx;width:380rpx;height:260rpx;background:url('data:image/png;base64,') center/250% auto no-repeat;opacity:.055;pointer-events:none}
.brand-route{display:flex;align-items:center;gap:22rpx;color:#b3c2d9;font-size:28rpx;line-height:1.4;margin:34rpx 0 44rpx;position:relative;z-index:1}
.route-arrow{width:114rpx;height:28rpx;background:url('data:image/png;base64,') center/100% 100% no-repeat;opacity:.8}
.role-title{font-size:78rpx;font-weight:650;line-height:1.18;letter-spacing:-2rpx;color:#fff;position:relative;z-index:1}
.role-title text{display:block}
.role-subtitle{display:block;font-size:27rpx;line-height:1.55;color:#b7c6dc;margin-top:20rpx;position:relative;z-index:1}
.role-list{display:flex;flex-direction:column;gap:24rpx;margin-top:42rpx;animation:login-enter .22s ease-out}
.role-card{display:flex;align-items:center;gap:24rpx;min-height:176rpx;padding:30rpx 28rpx 30rpx 30rpx;background:#1d2c42;border:1rpx solid #344964;border-left:10rpx solid #2156f3;border-radius:16rpx;box-shadow:none;transition:transform .16s ease,background .16s ease}
.role-icon{width:66rpx;height:66rpx;flex-shrink:0;background-position:center;background-size:contain;background-repeat:no-repeat}
.role-icon-salesman{background-image:url('data:image/png;base64,')}.role-icon-warehouse{background-image:url('data:image/png;base64,')}.role-icon-admin{background-image:url('data:image/png;base64,')}
.role-info{flex:1;min-width:0}.role-name{display:block;font-size:38rpx;line-height:1.4;font-weight:600;color:#fff;letter-spacing:-.5rpx}.role-desc{display:block;font-size:26rpx;line-height:1.6;color:#c0cde0;margin-top:10rpx}
.role-arrow{width:64rpx;height:64rpx;flex-shrink:0;border-radius:50%;background:#2156f3 url('data:image/png;base64,') center/36rpx 36rpx no-repeat}
.brand-footer{padding:46rpx 4rpx 8rpx;color:#8fabc9;font-size:24rpx;line-height:1.6}.footer-rule{height:3rpx;width:54rpx;background:#829cbd;margin-bottom:22rpx}.brand-footer text{display:block}.footer-en{font-size:19rpx;letter-spacing:5rpx;margin-top:7rpx;color:#7895b8}
/* Only app-owned content changes; native navigation retains its own height. */
.is-login{background:#fff;color:#171b22;padding:0 0 calc(20rpx + env(safe-area-inset-bottom))}
.role-header-compact,.is-login .brand-footer{display:none}
.login-form{display:flex;flex-direction:column;margin:0;padding:0;background:#fff;border:0;border-radius:0;box-shadow:none;animation:login-enter .18s ease-out}
.login-heading{position:relative;overflow:hidden;background:#111d2f;border-bottom:6rpx solid #2156f3;padding:20rpx 44rpx 32rpx;order:0}
.login-heading .brand-watermark{right:-56rpx;top:8rpx;width:320rpx;height:230rpx;opacity:.07}
.login-back{display:inline-flex;align-items:center;gap:12rpx;min-height:64rpx;font-size:27rpx;color:#e3ebf7;position:relative;z-index:1;margin-bottom:26rpx}
.back-arrow{width:32rpx;height:32rpx;background:url('data:image/png;base64,') center/contain no-repeat}
.login-title{position:relative;z-index:1;margin:0}
.login-title-row{display:flex;align-items:center;gap:20rpx}.login-role-icon{width:66rpx;height:66rpx;flex-shrink:0;border:1rpx solid #8293aa;border-radius:12rpx;background:url('data:image/png;base64,') center/42rpx 42rpx no-repeat}
.login-title .login-name{display:block;font-size:52rpx;line-height:1.3;font-weight:650;letter-spacing:-1rpx;color:#fff}
.login-title .login-subtitle{display:block;font-size:27rpx;line-height:1.5;color:#bdcbe0;margin-top:16rpx;font-weight:400}
.login-consent-hint{order:1;margin:24rpx 44rpx 18rpx;padding:0;color:#596577;font-size:25rpx;line-height:1.5}
.input-group{order:2;min-width:0;margin:0 44rpx 22rpx}
.input-label{display:block;margin-bottom:12rpx;font-size:28rpx;line-height:1.5;font-weight:600;color:#171b22}
.login-input{width:100%;height:94rpx;min-width:0;padding:0 22rpx 0 76rpx;box-sizing:border-box;background:#fff;border:2rpx solid #ccd6e4;border-radius:12rpx;color:#171b22;font-size:29rpx;line-height:1.5;background-position:24rpx center;background-size:32rpx 32rpx;background-repeat:no-repeat}
.input-name .login-input{background-image:url('data:image/png;base64,')}.input-phone .login-input{background-image:url('data:image/png;base64,')}.input-password .login-input{background-image:url('data:image/png;base64,')}
.login-input[disabled]{background-color:#f4f6f9;color:#637086;border-color:#dce3ee}
.login-input:focus{border-color:#2156f3;background-color:#fff}
.privacy-panel{order:3;margin:2rpx 44rpx 24rpx;padding:22rpx 24rpx 18rpx;border:1rpx solid #d7e3fa;border-radius:12rpx;background:#f1f5fc}
.privacy-title{display:block;font-size:28rpx;line-height:1.4;font-weight:600;color:#26354b;margin-bottom:10rpx}
.privacy-desc{display:block;font-size:25rpx;line-height:1.6;color:#4f6077;margin-bottom:10rpx}
.agreement-row{display:flex;align-items:center;min-height:66rpx}.agreement-text{font-size:26rpx;line-height:1.5;color:#26354b;margin-left:10rpx}
.agreement-links{display:flex;align-items:center;flex-wrap:wrap;gap:5rpx;font-size:25rpx;line-height:1.7}.agreement-link{color:#1748d5;font-weight:500;padding:6rpx 0}.agreement-and{color:#4f6077}
.btn-login{order:4;min-height:98rpx;margin:0 44rpx;padding:25rpx 20rpx;border-radius:12rpx;border:0;background:#2156f3;color:#fff;text-align:center;font-size:32rpx;font-weight:600;line-height:1.5;box-shadow:none;display:flex;align-items:center;justify-content:center}
.btn-login.btn-disabled{background:#d9e2f4;color:#50617e;opacity:1}
.login-cancel-btn{order:5;min-height:80rpx;margin:10rpx 44rpx 6rpx;padding:20rpx 0;text-align:center;color:#2156f3;font-size:27rpx;line-height:1.5;border:0;background:transparent}
@keyframes login-enter{from{opacity:.35;transform:translateY(10rpx)}to{opacity:1;transform:translateY(0)}}
@media(prefers-reduced-motion:reduce){.role-list,.login-form{animation:none}.role-card{transition:none}}
