<view class="container {{showLoginForm ? 'is-login' : 'is-selection'}}">
  <view class="role-header {{showLoginForm ? 'role-header-compact' : ''}}">
    <view class="brand-watermark"></view>
    <view class="brand-lockup"><view class="brand-logo"></view><text class="brand-name">一超物流</text></view>
    <view class="brand-route"><text>义乌</text><view class="route-arrow"></view><text>宁波</text></view>
    <view class="role-title"><text>选择身份</text><text>开启工作</text></view>
    <text class="role-subtitle">不同身份 · 对应不同的工作流程</text>
  </view>

  <!-- 角色选择 -->
  <view class="role-list" wx:if="{{!showLoginForm}}">
    <view class="role-card role-salesman" bindtap="selectRole" data-role="salesman" hover-class="ui-pressed">
      <view class="role-icon role-icon-salesman"></view>
      <view class="role-info">
        <text class="role-name">业务员 / 工厂</text>
        <text class="role-desc">查单、建单、查看账单</text>
      </view>
      <view class="role-arrow"></view>
    </view>

    <!-- 司机角色暂时冻结，代码保留 -->
    <view class="role-card" wx:if="{{false}}" bindtap="selectRole" data-role="driver" hover-class="ui-pressed">
      <text class="role-icon">司</text>
      <view class="role-info">
        <text class="role-name">司机</text>
      </view>
      <view class="role-arrow"></view>
    </view>

    <view class="role-card role-warehouse" bindtap="selectRole" data-role="warehouse" hover-class="ui-pressed">
      <view class="role-icon role-icon-warehouse"></view>
      <view class="role-info">
        <text class="role-name">接单员</text>
        <text class="role-desc">实测、收货、现结收款</text>
      </view>
      <view class="role-arrow"></view>
    </view>

    <view class="role-card role-admin" bindtap="selectRole" data-role="admin" hover-class="ui-pressed">
      <view class="role-icon role-icon-admin"></view>
      <view class="role-info">
        <text class="role-name">管理员</text>
        <text class="role-desc">报价、审核、费用配置</text>
      </view>
      <view class="role-arrow"></view>
    </view>
  </view>

  <view class="brand-footer"><view class="footer-rule"></view><text>让 物 流 更 简 单</text><text class="footer-en">YICHAO LOGISTICS</text></view>

  <!-- 登录表单 -->
  <view class="login-form" wx:if="{{showLoginForm}}">
    <view class="login-heading">
    <view class="brand-watermark"></view>
    <view class="login-back" bindtap="goBack" hover-class="ui-pressed">
      <view class="back-arrow"></view>
      <text>返回选择</text>
    </view>

    <view class="login-title">
      <view class="login-title-row"><view class="login-role-icon"></view><text class="login-name">{{selectedRoleName}}登录</text></view>
      <text class="login-subtitle">{{needsPassword ? '请输入手机号和密码' : '手机号授权绑定'}}</text>
    </view>

    </view>

    <view class="login-consent-hint">请填写登录信息，登录前勾选下方协议</view>

    <view class="privacy-panel">
      <text class="privacy-title">信息使用说明</text>
      <text class="privacy-desc">用于账号登录、身份识别、运单归属查询、账单展示和业务联系。阅读并同意后再继续。</text>
      <checkbox-group bindchange="onAgreementChange">
        <label class="agreement-row">
          <checkbox value="agreed" checked="{{agreementChecked}}" color="#2156f3" />
          <text class="agreement-text">我已阅读并同意</text>
        </label>
      </checkbox-group>
      <view class="agreement-links">
        <text class="agreement-link" bindtap="openServiceAgreement">《用户服务协议》</text>
        <text class="agreement-and">和</text>
        <text class="agreement-link" bindtap="openPrivacyPolicy">《隐私政策》</text>
      </view>
    </view>

    <!-- 管理员/接单员：账号密码登录 -->
    <block wx:if="{{needsPassword}}">
      <view class="input-group input-name">
        <text class="input-label">姓名</text>
        <input
          class="login-input"
          type="text"
          placeholder="请输入您的真实姓名"
          value="{{name}}"
          disabled="{{loggingIn}}"
          bindinput="onNameInput"
        />
      </view>

      <view class="input-group input-phone">
        <text class="input-label">手机号</text>
        <input
          class="login-input"
          type="number"
          placeholder="请输入手机号"
          value="{{phone}}"
          maxlength="11"
          disabled="{{loggingIn}}"
          bindinput="onPhoneInput"
        />
      </view>

      <view class="input-group input-password">
        <text class="input-label">密码</text>
        <input
          class="login-input"
          type="text"
          password="true"
          placeholder="请输入密码"
          value="{{password}}"
          disabled="{{loggingIn}}"
          bindinput="onPasswordInput"
        />
      </view>

      <view class="btn-login {{loggingIn || !agreementChecked ? 'btn-disabled' : ''}}" bindtap="doLogin" hover-class="ui-pressed">
        {{loggingIn ? '登录中...' : '进入系统'}}
      </view>
    </block>

    <!-- 业务员：手机号授权绑定 -->
    <block wx:if="{{!needsPassword}}">
      <view class="input-group input-name">
        <text class="input-label">姓名</text>
        <input
          class="login-input"
          type="text"
          placeholder="请输入您的真实姓名"
          value="{{name}}"
          disabled="{{loggingIn}}"
          bindinput="onNameInput"
        />
      </view>

      <view class="input-group input-phone">
        <text class="input-label">手机号</text>
        <input
          class="login-input"
          type="number"
          placeholder="请输入手机号"
          value="{{phone}}"
          maxlength="11"
          disabled="{{loggingIn}}"
          bindinput="onPhoneInput"
        />
      </view>

      <view class="btn-login {{loggingIn || !agreementChecked ? 'btn-disabled' : ''}}" bindtap="doLoginManual" hover-class="ui-pressed">
        {{loggingIn ? '登录中...' : '授权绑定并进入系统'}}
      </view>
    </block>
    <view class="login-cancel-btn" bindtap="goBack" hover-class="ui-pressed">返回身份选择</view>
  </view>
</view>
