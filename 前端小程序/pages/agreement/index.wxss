.doc-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f4f6fa;
  box-sizing: border-box;
}

.doc-card {
  padding: 34rpx 30rpx;
  background: #fff;
  border: 1rpx solid #e1e6ee;
  border-radius: 16rpx;
}

.doc-title {
  display: block;
  font-size: 50rpx;
  font-weight: 700;
  color: #171b22;
  line-height: 1.3;
}

.doc-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #596577;
}

.doc-section {
  margin-top: 34rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #171b22;
  margin-bottom: 12rpx;
}

.section-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #344156;
}
