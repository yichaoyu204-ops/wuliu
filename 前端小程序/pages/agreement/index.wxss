.doc-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f8f7f4;
  box-sizing: border-box;
}

.doc-card {
  padding: 34rpx 30rpx;
  background: #fff;
  border: 1rpx solid #e7ecf2;
  border-radius: 16rpx;
}

.doc-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #14213d;
  line-height: 1.3;
}

.doc-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #98a2b3;
}

.doc-section {
  margin-top: 34rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #14213d;
  margin-bottom: 12rpx;
}

.section-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  color: #475467;
}
