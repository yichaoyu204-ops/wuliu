@import "../../styles/ui.wxss";

/* 01 瑞士现代：以字号、分隔与单一主色区分信息及操作。 */
.container {
  min-height: 100vh;
  padding-bottom: calc(124rpx + env(safe-area-inset-bottom));
  background: #F4F6FA;
  color: #171B22;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
.page-title, .page-heading {
  margin: 0;
  padding: 44rpx 40rpx 10rpx;
  background: #FFFFFF;
  color: #171B22;
  font-size: 54rpx;
  line-height: 1.25;
  font-weight: 650;
  letter-spacing: -1.5rpx;
}
.page-title { padding-bottom: 36rpx; }
.role-bar { padding: 0 40rpx 30rpx; background: #FFFFFF; }
.role-text { color: #596577; font-size: 26rpx; line-height: 1.6; word-break: break-all; }
.tab-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  padding: 0 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E1E6ED;
}
.tab-item {
  position: relative;
  flex: 1;
  min-width: 0;
  min-height: 96rpx;
  padding: 24rpx 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex-wrap: wrap;
  color: #596577;
  font-size: 27rpx;
  line-height: 1.4;
  text-align: center;
  transition: background-color .18s ease, opacity .18s ease;
  box-sizing: border-box;
}
.tab-active { color: #2156F3; font-weight: 650; }
.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 52rpx;
  height: 5rpx;
  transform: translateX(-50%);
  background: #2156F3;
  border-radius: 1rpx;
}
.tab-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 32rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: #EEF2FF;
  color: #2156F3;
  font-size: 25rpx;
  line-height: 1.4;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}
.list-section { padding: 28rpx 0 8rpx; }
.workflow-card {
  margin: 0 28rpx 24rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border: 1rpx solid #E1E6ED;
  border-radius: 14rpx;
  box-shadow: none;
}
.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 26rpx;
}
.waybill-info { flex: 1 1 340rpx; min-width: 0; }
.document-label { display: block; margin-bottom: 8rpx; color: #596577; font-size: 25rpx; }
.waybill-no {
  display: block;
  color: #171B22;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 650;
  letter-spacing: -.5rpx;
  font-variant-numeric: tabular-nums;
  white-space: normal;
  word-break: break-all;
}
.creator-name, .business-no {
  display: block;
  margin-top: 10rpx;
  color: #596577;
  font-size: 25rpx;
  line-height: 1.5;
  white-space: normal;
  word-break: break-all;
}
.business-no { margin-top: 5rpx; }
.status-badge {
  flex-shrink: 0;
  max-width: 240rpx !important;
  min-height: 42rpx;
  padding: 7rpx 12rpx;
  background: #F0F3F8;
  color: #344156;
  border-radius: 6rpx;
  font-size: 25rpx;
  line-height: 1.45;
  font-weight: 550;
  white-space: normal;
  word-break: break-all;
}
.status-badge.created, .status-badge.measured_priced, .status-badge.factory_confirmed { background: #EEF2FF; color: #2156F3; }
.status-badge.admin_confirmed, .status-badge.warehouse_delivered, .status-badge.mainline, .status-badge.billed { background: #EEF2FF; color: #1745C8; }
.status-badge.completed { background: #F0F3F8; color: #596577; }
.card-body { padding-bottom: 24rpx; margin-bottom: 24rpx; border-bottom: 1rpx solid #E1E6ED; }
.cargo-info { display: flex; align-items: flex-start; padding: 22rpx 0; margin-bottom: 20rpx; border-top: 1rpx solid #E1E6ED; border-bottom: 1rpx solid #E1E6ED; }
.cargo-metric { flex: 1; min-width: 0; padding: 0 16rpx; border-left: 1rpx solid #E1E6ED; }
.cargo-metric:first-child { padding-left: 0; border-left: 0; }
.cargo-metric:last-child { padding-right: 0; }
.metric-label { display: block; margin-bottom: 7rpx; font-size: 25rpx; color: #596577; }
.metric-value { display: block; color: #171B22; font-size: 29rpx; line-height: 1.45; font-weight: 600; font-variant-numeric: tabular-nums; word-break: normal; overflow-wrap: anywhere; }
.route-info { margin-bottom: 14rpx; color: #344156; font-size: 28rpx; line-height: 1.55; word-break: break-all; }
.appointment-line { display: inline-block; max-width: 100%; padding: 6rpx 12rpx; margin: 0 0 8rpx; background: #F0F3F8; color: #596577; border-radius: 6rpx; font-size: 25rpx; line-height: 1.5; word-break: break-all; box-sizing: border-box; }
.appointment-line.pending { background: #EEF2FF; color: #2156F3; }
.appointment-line.done { background: #F0F3F8; color: #344156; }
.payment-type { margin-top: 8rpx; }
.pay-tag { font-weight: 500; display: inline-block; padding: 4rpx 0; font-size: 25rpx; color: #596577; line-height: 1.5; background: transparent; }
.pay-tag.monthly, .pay-tag.supplier_monthly, .pay-tag.spot { background: transparent; color: #596577; }
.card-actions { display: flex; align-items: stretch; flex-wrap: wrap; gap: 12rpx; }
.action-btn {
  flex: 1 1 220rpx;
  min-width: 0;
  min-height: 88rpx;
  padding: 18rpx 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
  transition: transform .18s ease, opacity .18s ease;
}
.btn-primary, .btn-warn { background: #2156F3; color: #FFFFFF; border: 1rpx solid #2156F3; }
.btn-secondary { background: #F3F5F9; color: #344156; border: 1rpx solid #E1E6ED; }
.btn-danger { flex: 0 1 112rpx; min-width: 112rpx; background: #FFFFFF; color: #B93630; border: 1rpx solid #EBCFCD; }
.btn-disabled { opacity: .5; }
.step-num { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; width: 32rpx; height: 32rpx; border-radius: 50%; font-size: 25rpx; line-height: 1; font-weight: 550; }
.btn-secondary .step-num { background: #E1E6ED; color: #344156; }
.btn-primary .step-num { background: rgba(255,255,255,.18); color: #FFFFFF; }
.action-arrow { align-self: center; flex-shrink: 0; font-size: 26rpx; color: #596577; }
.date-group { padding: 30rpx 32rpx 18rpx; }
.date-group-label { color: #596577; font-size: 27rpx; font-weight: 550; }
.create-time { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8rpx 14rpx; margin: 8rpx 0 12rpx; }
.time-label, .time-value { color: #596577; font-size: 25rpx; font-variant-numeric: tabular-nums; }
.empty-state { display: flex; flex-direction: column; align-items: center; margin: 28rpx; padding: 88rpx 28rpx; background: #FFFFFF; border: 1rpx solid #E1E6ED; border-radius: 14rpx; text-align: center; }
.empty-text { margin-bottom: 12rpx; color: #344156; font-size: 30rpx; }
.empty-hint { color: #596577; font-size: 26rpx; line-height: 1.55; }
.list-section .empty-state { margin: 0 28rpx 24rpx; }
.card-body .card-actions { margin-top: 24rpx; }
.pay-modal { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; }
.pay-mask { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: rgba(23,27,34,.48); }
.pay-content { position: relative; z-index: 1; width: calc(100vw - 48rpx); max-width: 680rpx; max-height: 88vh; padding: 36rpx 30rpx 30rpx; background: #FFFFFF; border-radius: 16rpx; display: flex; flex-direction: column; box-sizing: border-box; text-align: center; animation: core-dialog-in .18s ease-out both; }
.pay-title { margin-bottom: 18rpx; color: #171B22; font-size: 36rpx; line-height: 1.3; font-weight: 650; }
.pay-amount { margin-bottom: 12rpx; color: #171B22; font-size: 64rpx; line-height: 1.2; font-weight: 650; font-variant-numeric: tabular-nums; word-break: break-all; }
.pay-hint { margin-bottom: 24rpx; color: #596577; font-size: 26rpx; line-height: 1.5; }
.pay-qr-list { max-height: 48vh; margin-bottom: 24rpx; min-height: 0; }
.pay-qr-card { margin-bottom: 16rpx; padding: 18rpx; border: 1rpx solid #E1E6ED; border-radius: 12rpx; background: #FFFFFF; }
.pay-qr-head { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 10rpx; margin-bottom: 16rpx; }
.pay-qr-name { color: #171B22; font-size: 28rpx; font-weight: 600; }
.pay-qr-hint { color: #596577; font-size: 25rpx; line-height: 1.5; }
.pay-qr-image { display: block; width: 100%; height: 400rpx; border-radius: 6rpx; background: #FFFFFF; }
.pay-actions { display: flex; gap: 14rpx; flex-shrink: 0; }
.pay-btn { flex: 1; min-height: 88rpx; padding: 20rpx 10rpx; border-radius: 10rpx; text-align: center; font-size: 28rpx; line-height: 1.45; font-weight: 600; display: flex; align-items: center; justify-content: center; box-sizing: border-box; transition: transform .18s ease, opacity .18s ease; }
.pay-btn-secondary { color: #344156; background: #F3F5F9; border: 1rpx solid #E1E6ED; }
.pay-btn-primary { color: #FFFFFF; background: #2156F3; }
@keyframes core-dialog-in { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
@media (max-width: 350px) {
  .tab-bar { padding: 0 12rpx; }
  .tab-item { font-size: 26rpx; }
  .workflow-card { padding: 26rpx; }
  .action-btn { flex-basis: 220rpx; padding-left: 10rpx; padding-right: 10rpx; }
  .cargo-metric { padding-left: 12rpx; padding-right: 12rpx; }
}
@media (prefers-reduced-motion: reduce) { .pay-content { animation: none; } .action-btn, .pay-btn, .tab-item { transition: none; } }
