@import "../../styles/ui.wxss";

/* 页面只定义本页布局，通用视觉由 styles/ui.wxss 维护。 */
.container {
  background: #fff;
  min-height: 100vh;
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
  color: #171b22;
  font-size: 28rpx;
  line-height: 1.5;
  padding-top: 12rpx;
}

.loading-state {
  text-align: center;
  padding: 160rpx 32rpx;
  font-size: 28rpx;
  color: #596577;
}

/* 状态卡片 */
.status-card {
  background: #2156f3;

  margin: 24rpx 40rpx 44rpx;

  border-radius: 12rpx;

  padding: 36rpx 32rpx;
  display: flex;
  align-items: flex-start;
  color: #fff;
  box-shadow: none;
  min-height: 176rpx;
}

.status-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.08);
  text-align: center;
  line-height: 82rpx;
  font-size: 48rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
  border: 1rpx solid rgba(255,255,255,0.22);
}

.status-info {
  flex: 1;
  min-width: 0;
}

.status-name {
  display: block;

  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  overflow: visible;
  text-overflow: clip;
  white-space: normal;

  line-height: 1.3;
  word-break: break-all;
}

.status-desc {
  font-size: 28rpx;
  opacity: 1;
  line-height: 1.55;
  display: block;

  color: #e9efff;
  word-break: break-all;
}

.appointment-tag {
  display: inline-block;
  max-width: 100%;
  margin-top: 14rpx;
  padding: 7rpx 12rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.5;
  white-space: normal;
  word-break: break-all;
}

.appointment-tag.done {
  background: rgba(99,198,180,0.13);
  color: #CDF3E9;
}

.appointment-tag.pending {
  background: rgba(233,101,32,0.16);
  color: #FFD9C3;
}

/* 区块 */
.section {
  margin: 0 40rpx 44rpx;
  background: transparent;
  border: 0;
  border-radius: 0;
  box-shadow: none;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #171b22;

  margin-bottom: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 0;
  min-height: 56rpx;
  gap: 16rpx;
  flex-wrap: wrap;
}

/* 信息卡片 */
.info-card, .route-card, .fee-card, .measure-card, .quote-card {
  background: #fff;

  border-radius: 0;

  padding: 4rpx 0;

  border: 0;
  box-shadow: none;
  border-top: 1rpx solid #e1e6ee;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf0f4;
  gap: 20rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #596577;
  width: 208rpx;
  flex-shrink: 0;
  margin-right: 0;
  display: block;
  line-height: 1.55;
}

.info-value {
  font-size: 30rpx;
  color: #171b22;
  text-align: right;
  flex: 1;
  min-width: 0;
  word-break: break-all;
  margin-left: 0;
  display: block;
  line-height: 1.55;
}

.info-value.hint {
  color: #7D8999;
}

/* 编辑模式 */
.edit-btn {
  font-size: 26rpx;
  color: #303b4c;
  padding: 10rpx 22rpx;
  border: 1rpx solid #dde3ec;
  border-radius: 14rpx;
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  background: #FFFFFF;
}

.edit-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.edit-action {
  font-size: 26rpx;
  padding: 10rpx 20rpx;
  border-radius: 14rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
}

.edit-action.cancel {
  color: #526278;
  border: 1rpx solid #dde3ec;
  background: #FFFFFF;
}

.edit-action.save {
  color: #FFFFFF;
  background: #2156f3;
  border: 1rpx solid #2156f3;
}

.edit-input {
  flex: 1;
  border: 1rpx solid #dde3ec;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  font-size: 28rpx;
  color: #171b22;
  background: #f4f6fa;
  text-align: right;
  margin-left: 0;
  min-width: 0;
  min-height: 76rpx;
  height: 76rpx;
  box-sizing: border-box;
}

.edit-input-group {
  display: flex;
  align-items: center;
  flex: 1;
  justify-content: flex-end;
  margin-left: 0;
  gap: 10rpx;
  min-width: 0;
  flex-wrap: wrap;
}

.edit-input.small {
  width: 120rpx;
  flex: none;
  margin-left: 0;
  text-align: center;
}

.edit-unit {
  font-size: 24rpx;
  color: #596577;
  flex-shrink: 0;
}

.radio-label {
  display: flex;
  align-items: center;
  margin-left: 0;
  font-size: 26rpx;
  color: #171b22;
  min-height: 68rpx;
  line-height: 1.5;
}

.mono {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
}

/* 路线卡片 */
.route-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #171b22;
  margin-bottom: 8rpx;
  line-height: 1.5;
  word-break: break-all;
}

.route-desc {
  font-size: 26rpx;
  color: #596577;
  margin-bottom: 20rpx;
  line-height: 1.55;
  word-break: break-all;
}

.warehouse-info {
  background: #f4f6fa;
  border-radius: 16rpx;
  padding: 22rpx;
  line-height: 1.55;
  word-break: break-all;
}

.warehouse-label {
  font-size: 24rpx;
  color: #596577;
  margin-right: 16rpx;
  display: block;
  margin-bottom: 8rpx;
}

.warehouse-value {
  font-size: 29rpx;
  color: #171b22;
  font-weight: 600;
  display: block;
}

.warehouse-address {
  display: block;
  font-size: 25rpx;
  color: #596577;
  margin-top: 8rpx;
  line-height: 1.55;
}

/* 时间线 */
.timeline {
  background: #fff;

  border-radius: 0;

  padding: 28rpx 0;

  border: 0;
  box-shadow: none;
  border-top: 1rpx solid #e1e6ee;
}

.timeline-item {
  position: relative;
  padding-left: 44rpx;
  padding-bottom: 36rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #BAC5D2;
  border: 5rpx solid #EEF2F6;
}

.timeline-dot.completed {
  background: #16776D;
  border-color: #EAF6F1;
}

.timeline-dot.active {
  background: #2156f3;

  border-color: #eaf0ff;
}

.timeline-line {
  position: absolute;
  left: 11rpx;
  top: 32rpx;
  width: 2rpx;
  height: calc(100% - 24rpx);
  background: #e1e6ee;
}

.timeline-content {
  margin-top: 0;
  min-width: 0;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.timeline-name {
  font-size: 28rpx;
  color: #171b22;
  font-weight: 600;
  flex: 1 1 240rpx;
  min-width: 0;
  line-height: 1.5;
  word-break: break-all;
}

.timeline-status {
  font-size: 23rpx;
  padding: 5rpx 12rpx;
  border-radius: 10rpx;
  background: #EEF2F6;
  color: #596577;
  flex-shrink: 0;
  font-weight: 500;
  line-height: 1.45;
  max-width: 100%;
  white-space: normal;
  word-break: break-all;
}

.timeline-status.completed {
  background: #EAF6F1;
  color: #16776D;
}

.timeline-status.active {
  background: #eaf0ff;

  color: #2156f3;
}

.timeline-time {
  font-size: 25rpx;
  color: #596577;
  margin-bottom: 4rpx;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

.timeline-operator {
  font-size: 24rpx;
  color: #596577;
  margin-bottom: 4rpx;
  line-height: 1.5;
  word-break: break-all;
}

.timeline-remark {
  font-size: 25rpx;
  color: #596577;
  background: #f4f6fa;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
  line-height: 1.55;
  word-break: break-all;
}

.timeline-photos {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.timeline-photo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  object-fit: cover;
  background: #EEF2F6;
}

/* 费用卡片 */
.fee-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf0f4;
  gap: 20rpx;
  align-items: flex-start;
  flex-wrap: wrap;
}

.fee-name {
  font-size: 28rpx;
  color: #303b4c;
  flex: 1;
  min-width: 0;
  line-height: 1.5;
  word-break: break-all;
}

.fee-amount {
  font-size: 29rpx;
  color: #171b22;
  font-weight: 600;
  flex-shrink: 0;
  max-width: 100%;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}

.fee-divider {
  height: 2rpx;
  background: #e1e6ee;
  margin: 16rpx 0;
}

.fee-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 12rpx 0;
}

.fee-total-label {
  font-size: 28rpx;
  color: #171b22;
  font-weight: 600;
}

.fee-total-amount {
  font-size: 48rpx;

  color: #2156f3;
  font-weight: 700;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}

/* 实测卡片 */
.measure-row {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf0f4;
  gap: 20rpx;
  align-items: flex-start;
}

.measure-row:last-child {
  border-bottom: none;
}

.measure-label {
  font-size: 27rpx;
  color: #596577;
  line-height: 1.55;
  flex-shrink: 0;
}

.measure-value {
  font-size: 29rpx;
  color: #171b22;
  font-weight: 600;
  text-align: right;
  line-height: 1.55;
  min-width: 0;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}

/* 报价卡片 */
.quote-status {
  font-size: 24rpx;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  font-weight: 500;
  line-height: 1.45;
  max-width: 100% !important;
  word-break: break-all;
}

.quote-status.draft {
  color: #596577;
  background: #EEF2F6;
}

.quote-status.sent {
  color: #A94B18;
  background: #FFF1E8;
}

.quote-status.confirmed {
  color: #16776D;
  background: #EAF6F1;
}

.quote-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf0f4;
  gap: 20rpx;
  flex-wrap: wrap;
}

.quote-row.excluded .quote-name,
.quote-row.excluded .quote-detail,
.quote-row.excluded .quote-amount {
  color: #7D8999;
  text-decoration: line-through;
}

.quote-left {
  flex: 1 1 280rpx;
  min-width: 0;
  margin-right: 0;
}

.quote-name {
  font-size: 28rpx;
  color: #171b22;
  display: block;
  font-weight: 500;
  line-height: 1.5;
  word-break: break-all;
}

.quote-detail {
  font-size: 24rpx;
  color: #596577;
  margin-top: 8rpx;
  line-height: 1.55;
  display: block;
  word-break: break-all;
}

.quote-amount {
  font-size: 29rpx;
  color: #171b22;
  font-weight: 600;
  flex-shrink: 0;
  line-height: 1.5;
  max-width: 100%;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}

.quote-divider {
  height: 1rpx;
  background: #e1e6ee;
  margin: 0;
}

.quote-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0 16rpx;
  gap: 16rpx;
  flex-wrap: wrap;
}

.quote-total-label {
  font-size: 28rpx;
  color: #171b22;
  font-weight: 600;
}

.quote-total-amount {
  font-size: 48rpx;

  color: #2156f3;
  font-weight: 700;
  line-height: 1.25;
  word-break: break-all;
  font-variant-numeric: tabular-nums;
}

.quote-note {
  margin-top: 16rpx;
  padding: 18rpx;
  background: #f4f6fa;
  border-radius: 14rpx;
  font-size: 25rpx;
  color: #596577;
  margin: 8rpx 0 16rpx;
  line-height: 1.55;
  word-break: break-all;
}

/* 进仓单原件 */
.attachment-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #e1e6ee;
  text-align: center;
  box-shadow: none;
}

.attachment-thumb {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  object-fit: cover;
  background: #EEF2F6;
}

.attachment-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #596577;
  line-height: 1.5;
}

/* 底部操作 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e1e6ee;
  box-shadow: none;
  z-index: 20;
}

.btn-primary {
  background: #2156f3;
  color: #FFFFFF;
  text-align: center;
  padding: 20rpx 24rpx;

  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;

  min-height: 96rpx;
  line-height: 1.5;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s ease, opacity 0.18s ease;
  box-shadow: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 28rpx;
  margin: 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e1e6ee;
  background: #FFFFFF;
  box-shadow: none;
  text-align: center;
}

.empty-text {
  font-size: 30rpx;
  color: #303b4c;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.empty-hint {
  font-size: 26rpx;
  color: #596577;
  line-height: 1.5;
}

.route-card {
  padding: 24rpx 0;
}

.form-picker-wide {
  flex: 1;
  min-width: 0;
}

.date-picker-text {
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #dde3ec;
  background: #f4f6fa;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

@media (prefers-reduced-motion: reduce) {
  .btn-primary { transition: none; }
}
