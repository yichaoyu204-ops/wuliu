/* Native tab layout with the approved outlined icon set. */
.bar{position:fixed;left:0;right:0;bottom:0;height:calc(112rpx + env(safe-area-inset-bottom));z-index:9999;color:#59667b}.bg{position:absolute;inset:0;background:#fff;border-top:1rpx solid #e1e6ee}.inner{position:absolute;left:8rpx;right:8rpx;bottom:env(safe-area-inset-bottom);height:112rpx;display:flex}.item{flex:1;min-width:0;position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;padding-top:4rpx;transition:opacity .18s ease}.item:active,.ui-pressed{opacity:.7}.icon{position:relative;width:44rpx;height:44rpx;margin-bottom:9rpx}.label{font-size:22rpx;line-height:1.4;color:#59667b;white-space:nowrap;font-weight:400}.label.on{color:#2156f3;font-weight:600}.dot{display:none}.badge{position:absolute;top:-10rpx;left:31rpx;min-width:29rpx;height:29rpx;padding:0 5rpx;line-height:25rpx;text-align:center;border:2rpx solid #fff;border-radius:30rpx;background:#2156f3;color:#fff;font-size:19rpx;font-weight:500;box-sizing:border-box;white-space:nowrap;z-index:1}
.home-body,.plus-v,.doc-line,.doc-dot,.flow-line,.flow-dot,.calendar-body,.calendar-dot,.line{display:none}
.home-roof{display:block;position:absolute;inset:0;top:0!important;left:0!important;width:44rpx;height:44rpx;background:url('data:image/png;base64,') center/contain no-repeat}
.home-roof.on{background-image:url('data:image/png;base64,')}
.plus-h{display:block;position:absolute;inset:0;top:0!important;left:0!important;width:44rpx;height:44rpx;background:url('data:image/png;base64,') center/contain no-repeat}
.plus-h.on{background-image:url('data:image/png;base64,')}
.doc-line:first-child{display:block;position:absolute;inset:0;top:0!important;left:0!important;width:44rpx;height:44rpx;background:url('data:image/png;base64,') center/contain no-repeat}
.doc-line.on:first-child{background-image:url('data:image/png;base64,')}
.flow-line:first-child{display:block;position:absolute;inset:0;top:0!important;left:0!important;width:44rpx;height:44rpx;background:url('data:image/png;base64,') center/contain no-repeat}
.flow-line.on:first-child{background-image:url('data:image/png;base64,')}
.calendar-top{display:block;position:absolute;inset:0;top:0!important;left:0!important;width:44rpx;height:44rpx;background:url('data:image/png;base64,') center/contain no-repeat}
.calendar-top.on{background-image:url('data:image/png;base64,')}
.line:first-child{display:block;position:absolute;inset:0;top:0!important;left:0!important;width:44rpx;height:44rpx;background:url('data:image/png;base64,') center/contain no-repeat}
.line.on:first-child{background-image:url('data:image/png;base64,')}
@media(prefers-reduced-motion:reduce){.item{transition:none}}
